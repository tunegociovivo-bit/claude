# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgresql://agencia:agencia@localhost:5432/agencia?schema=public

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia-esto-en-produccion-cadena-aleatoria-larga

# --- Google SSO (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MinIO (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agencia-files

# --- Redis (colas y rate limit) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_KEY=

# --- Asana (lo usarás cuando hagamos la migración) ---
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- API ---
# Prefijo para las API keys públicas
API_KEY_PREFIX=ag_
# Origen permitido para CORS de la API pública (coma-separado)
API_ALLOWED_ORIGINS=*

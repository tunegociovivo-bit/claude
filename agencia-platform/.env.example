# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Postgres ---
DATABASE_URL=postgresql://agencia:agencia@localhost:5432/agencia?schema=public

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia-esto-en-produccion-cadena-aleatoria-larga

# --- Google OAuth (SSO + Google Calendar bidireccional) ---
# El mismo client_id/secret cubre login Google y la sincronización de
# Google Calendar (scope `calendar` se pide en el flow de conexión
# desde /perfil, no en el login).
# Configura el redirect URI en Google Cloud Console para AMBOS:
#   {NEXTAUTH_URL}/api/auth/callback/google
#   {NEXTAUTH_URL}/api/integrations/google-calendar/callback
#   {NEXTAUTH_URL}/api/integrations/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MinIO (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=agencia-files

# --- Redis (colas y rate limit) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_KEY=

# --- Asana (lo usarás cuando hagamos la migración) ---
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- API ---
# Prefijo para las API keys públicas
API_KEY_PREFIX=ag_
# Origen permitido para CORS de la API pública (coma-separado)
API_ALLOWED_ORIGINS=*

# ── GMB Hub — Centro de crecimiento SEO local (fase 5) ──────────────────────────
# Conexiones del módulo /gmb-hub. Sin estas variables, cada capacidad queda
# "sin conectar" de forma honesta (la UI lo indica); nunca se simulan datos.
#   - Google Maps: habilita Rank Grid y comparación de competencia.
GOOGLE_MAPS_API_KEY=
#   - Modelos del AI Council (multimodelo). Cada uno es opcional e independiente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
#   - Make (ingesta de reseñas + publicar respuestas): se configura por workspace
#     en Ajustes de la ficha (settings.integrations.gmb: replyWebhookUrl + webhookToken).
#     Fallback global del token entrante:
GMB_WEBHOOK_TOKEN=
#   - Google Business Profile (API directa opcional para publicar/responder):
#     se conecta por OAuth de Google (GoogleAdsConnection, scope business.manage).

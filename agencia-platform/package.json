{
  "name": "agencia-platform",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma db push --accept-data-loss=false --skip-generate && next start",
    "lint": "node scripts/check-tenant-guards.mjs && next lint",
    "lint:tenant": "node scripts/check-tenant-guards.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && prisma db execute --file prisma/migrations/20260913190000_leads_multichannel_email/migration.sql --schema prisma/schema.prisma && tsx scripts/backfill-leads-multichannel.ts",
    "db:backfill:leads": "tsx scripts/backfill-leads-multichannel.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi": "tsx scripts/build-openapi.ts",
    "cron:tick": "tsx scripts/cron-tick.ts",
    "test:sonia-schedule": "tsx scripts/test-sonia-schedule.ts",
    "bubui:stripe-setup": "node scripts/bubui-stripe-setup.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:seed": "tsx scripts/seed-e2e.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },

# --- Configuración del agente bancario LOCAL de Negocio Vivo ---
# Copia este fichero a `.env` (o usa un `agent.config.json` protegido) y rellénalo.
# NUNCA pongas aquí credenciales del banco: el agente NO las usa. El login,
# el gestor de contraseñas y el OTP los haces TÚ en tu navegador.

# URL del HUB (obligatorio). Debe ser HTTPS.
HUB_URL=https://hub.negociovivo.app

# Token del agente, emitido UNA sola vez al enrolarlo en /facturacion/remesas → Agente bancario.
# Guárdalo aquí o en el fichero de config protegido. Si lo pierdes, revócalo y enrola de nuevo.
AGENT_TOKEN=

# Dominio OFICIAL de Santander Empresas (allowlist estricta). El agente SOLO
# operará en este host; cualquier otra URL provoca pausa por seguridad.
SANTANDER_ORIGIN=https://empresas.santander.es

# Puerto de depuración remota de tu Chrome VISIBLE (CDP). Arranca Chrome con:
#   chrome.exe --remote-debugging-port=9222 --user-data-dir="%LOCALAPPDATA%\NVAgentChrome"
# El agente se CONECTA a esa sesión visible; no abre un navegador headless ni oculto.
CHROME_CDP_URL=http://127.0.0.1:9222

# Modo del adaptador Santander:
#   mock   → no toca el banco (pruebas/dry-run). POR DEFECTO.
#   live   → opera en el Chrome visible con los selectores de selectors.json.
# En 'live', si faltan selectores o algo no cuadra, el agente PAUSA (NEEDS_USER).
SANTANDER_MODE=mock

# Ruta al fichero de selectores del portal (se genera con `npm run record`).
# Si no existe y el modo es 'live', el agente pausa y pide mapear el portal.
SELECTORS_FILE=./selectors.json

# Segundos entre latidos (heartbeat) y sondeos de trabajo.
HEARTBEAT_SECONDS=30
POLL_SECONDS=15

# Nivel de log local: info | debug. Los logs se sanean SIEMPRE (sin secretos).
LOG_LEVEL=info

{
  "name": "negocio-vivo-time-agent",
  "version": "0.1.1",
  "description": "Agente multiplataforma de control horario de Negocio Vivo",
  "author": "Negocio Vivo",
  "private": true,
  "main": "src/main.js",
  "scripts": { "dev": "electron .", "dist:win": "electron-builder --win nsis", "dist:mac": "electron-builder --mac dmg" },
  "dependencies": {
    "axios": "^1.12.0",
    "electron-store": "^8.2.0",
    "keytar": "^7.9.0",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": { "electron": "^32.3.3", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "app.negociovivo.timetracker",
    "productName": "Negocio Vivo Control Horario",
    "files": ["src/**/*", "package.json"],
    "mac": { "category": "public.app-category.productivity", "target": ["dmg"], "hardenedRuntime": true, "entitlements": "build/entitlements.mac.plist", "entitlementsInherit": "build/entitlements.mac.plist" },
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}

# Copia a .env y rellena. NO subas el .env real a git.

# API key global de Evolution. ES LA QUE PONDRÁS EN EL HUB.
# Genérala con:  openssl rand -hex 24
EVOLUTION_API_KEY=CAMBIA_ESTA_CLAVE

# --- Opción A: SIN HTTPS (docker-compose.yml) ---------------------------
# URL pública del servidor (la IP de tu VPS + puerto 8080).
SERVER_URL=http://116.203.16.76:8080

# --- Opción B: CON HTTPS (docker-compose.https.yml) ---------------------
# Subdominio que apunta (registro DNS A) a la IP del VPS. Caddy saca el
# certificado solo. En el Hub usarás https://ESTE_DOMINIO (sin puerto).
EVOLUTION_DOMAIN=evolution.negociovivo.app

# Password de la base de datos interna (cualquiera larga).
# Genérala con:  openssl rand -hex 16
POSTGRES_PASSWORD=CAMBIA_ESTA_PASSWORD

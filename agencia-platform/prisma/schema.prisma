// Prisma schema for Agencia Hub (Phase 2)
// Modelo multi-tenant: cada cuenta es un Workspace, con miembros (users)
// y todos los recursos llevan workspaceId para aislamiento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// AUTH (NextAuth.js)
// ====================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  phone         String? // para futuras notificaciones SMS/WhatsApp
  emailVerified DateTime?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 2FA TOTP (RFC 6238). totpSecret es base32, cifrado con
  // NEXTAUTH_SECRET (igual que los tokens Asana). totpEnabledAt se
  // setea tras la primera verificación exitosa — antes de eso el
  // user puede abortar la inscripción sin penalty.
  totpSecret      String?
  totpEnabledAt   DateTime?
  // Códigos de recuperación: 8 strings de 10 chars hasheados (bcrypt).
  // Se generan al activar 2FA. Cada uso los marca como consumidos.
  totpBackupCodes Json?

  // Para forzar verificación tras cambio de email crítico o
  // re-verificación periódica. Si null, no se exige.
  emailVerificationRequiredAt DateTime?

  accounts                  Account[]
  sessions                  Session[]
  memberships               Membership[]
  projectMembers            ProjectMember[]
  ownedApiKeys              ApiKey[]
  asanaTokens               AsanaConnection[]
  notifications             Notification[]
  pushSubscriptions         PushSubscription[]
  comments                  Comment[]
  assignedTasks             TaskAssignee[]
  externalCalendars         UserExternalCalendar[]
  vacationDays              VacationDay[]
  teamMessages              TeamMessage[]
  editorialMessages         EditorialPostMessage[]
  googleCalendarConnections GoogleCalendarConnection[]
  userSessions              UserSession[]
  MetaConnection            MetaConnection[]
  aiMemoryEntries           AiUserMemory[]
  managedProjects           Project[]                  @relation("ProjectManager")
  emailAccounts             EmailAccount[]             @relation("UserEmailAccounts")
}

// Registro de intentos de login para throttling/lockout. Se guardan
// éxitos y fracasos. La lógica en lib/security/login-throttle.ts
// rechaza nuevos intentos si en los últimos LOCK_WINDOW_MIN minutos
// hubo >= LOCK_MAX_FAILS fallos para el mismo email O para la misma
// IP. Limpieza periódica vía cron /api/cron/login-attempts-purge.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  userAgent String?  @db.Text
  success   Boolean
  reason    String? // p.ej. "bad_password", "locked", "no_user"
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Sesión activa de un usuario (manualmente trackeada — la JWT de
// NextAuth no se guarda en BD, así que esto nos permite listar y
// revocar dispositivos desde /perfil/seguridad). Se crea en el
// callback de signIn y se actualiza lastSeenAt en cada request
// autenticado (middleware). Para revocar: revokedAt != null hace que
// authenticate() rechace cualquier petición con esa sessionId.
model UserSession {
  id            String    @id @default(cuid())
  userId        String
  // Identificador estable que viaja en la JWT como `sid`. Si no
  // coincide con ninguna sesión viva, se rechaza la petición.
  sid           String    @unique
  deviceLabel   String? // p.ej. "Chrome on Mac", "Safari iOS"
  ip            String?
  userAgent     String?   @db.Text
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String? // "logout", "user_revoked", "password_changed", "admin_revoked"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([sid])
}

// Calendarios externos del usuario (Google Calendar, Outlook, iCloud,
// Proton...) vinculados vía "secret iCal URL". Se fetchean en el
// /calendario para mostrar eventos personales junto a los de la
// plataforma. Compatible con cualquier proveedor que exporte .ics.
//
// Cómo obtener la URL en Google Calendar:
//   Settings → Settings for my calendars → [calendario] →
//   "Integrate calendar" → "Secret address in iCal format"
model UserExternalCalendar {
  id           String    @id @default(cuid())
  userId       String
  workspaceId  String
  name         String
  icsUrl       String    @db.Text
  // Hex color para distinguir en la grid del calendario. Default
  // violeta para que destaque sobre los eventos del workspace.
  color        String    @default("#8b5cf6")
  enabled      Boolean   @default(true)
  lastSyncedAt DateTime?
  lastError    String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
}

enum UserRole {
  ADMIN
  MEMBER
  GUEST
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====================================================================
// WORKSPACE & MEMBERSHIP
// ====================================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  settings  Json? // { ai: { anthropicApiKey: "...", defaultModel: "..." }, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  clients                   Client[]
  projects                  Project[]
  tasks                     Task[]
  documents                 Document[]
  databases                 Database[]
  tags                      Tag[]
  files                     File[]
  events                    CalendarEvent[]
  apiKeys                   ApiKey[]
  webhooks                  Webhook[]
  auditLogs                 AuditLog[]
  asanaImports              AsanaImport[]
  comments                  Comment[]
  reviewClients             ReviewClient[]
  voiceBusinesses           VoiceBusiness[]
  editorialPosts            EditorialPost[]
  approvalLinks             ClientApprovalLink[]
  deliverables              Deliverable[]
  credentialGrants          CredentialAccessGrant[]
  leadSearches              LeadSearch[]
  leads                     Lead[]
  leadTemplates             LeadTemplate[]
  leadSequences             LeadSequence[]
  leadInboxMsgs             LeadInboxMessage[]
  leadMessages              LeadMessage[]
  leadExclusions            LeadExclusion[]
  leadOptouts               LeadOptout[]
  leadConversationMetas     LeadConversationMeta[]
  leadBroadcasts            LeadBroadcast[]
  leadBroadcastRecipients   LeadBroadcastRecipient[]
  leadExecOutreach          LeadExecOutreach[]
  externalCalendars         UserExternalCalendar[]
  vacationDays              VacationDay[]
  teamMessages              TeamMessage[]
  googleCalendarConnections GoogleCalendarConnection[]
  emailAccounts             EmailAccount[]
  searchEmbeddings          SearchEmbedding[]
  metaConnections           MetaConnection[]
  metaCampaigns             MetaCampaign[]
  aiAgentRuns               AiAgentRun[]
  aiDrafts                  AiDraft[]
  aiClientMemories          AiClientMemory[]
  aiAgentLessons            AiAgentLesson[]
  taskTemplates             TaskTemplate[]
  aiWorkspaceMemory         AiWorkspaceMemory?
  aiUserMemories            AiUserMemory[]
  aiProposedTools           AiProposedTool[]
  aiOwnerships              AiOwnership[]
  aiClientWorkflows         AiClientWorkflow[]
  googleAdsConnection       GoogleAdsConnection?
  pricingServices           PricingService[]
  deals                     Deal[]
  liveMeetingSessions       LiveMeetingSession[]
  invoices                  Invoice[]
  invoiceIssuers            InvoiceIssuer[]
  invoiceCounters           InvoiceCounter[]
  expenses                  Expense[]
}

// ====================================================================
// FACTURACIÓN (gestor de facturas tipo Holded, admin-only)
// ====================================================================

// Empresa emisora. Soporta varios perfiles (multi-emisor). Cada factura
// referencia un emisor; sus datos se "congelan" en la factura al emitir.
model InvoiceIssuer {
  id          String  @id @default(cuid())
  workspaceId String
  name        String // nombre comercial
  legalName   String? // razón social (si difiere)
  taxId       String // NIF/CIF
  address     String?
  postalCode  String?
  city        String?
  province    String?
  countryCode String  @default("ESP") // ISO 3166-1 alpha-3 (Facturae)
  email       String?
  phone       String?
  web         String?
  iban        String? // para transferencia / remesa SEPA
  logoUrl     String?
  // Facturae: tipo de persona (F=física, J=jurídica) y residencia (R/E/U).
  personType    String @default("J") // F | J
  residenceType String @default("R") // R (residente) | E (extranjero) | U (UE)
  isDefault   Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  clients   Client[]  @relation("IssuerClients")
  expenses  Expense[]

  @@index([workspaceId])
}

// Estado del guardián anti-bloqueo de Meta. Fila única ("global") para
// que el enfriamiento (cooldown) sobreviva a reinicios del servidor: si
// Meta nos está limitando y el proceso reinicia, no volvemos a escribir
// hasta que pase el enfriamiento.
model MetaGuardState {
  id            String    @id @default("global")
  cooldownUntil DateTime?
  reason        String?
  lastUsagePct  Float     @default(0)
  updatedAt     DateTime  @updatedAt
}

// Gastos de una empresa emisora (compras, suministros, cuotas, etc.).
// A diferencia de las facturas emitidas, aquí registramos los gastos que
// la empresa asume, para tener una visión de resultado por empresa.
model Expense {
  id          String  @id @default(cuid())
  workspaceId String
  issuerId    String? // empresa que asume el gasto

  date     DateTime @default(now())
  // category: CUOTA_AUTONOMO | SOFTWARE | PUBLICIDAD | PROVEEDORES |
  //           SUMINISTROS | ALQUILER | MATERIAL | VIAJES | IMPUESTOS |
  //           BANCO | OTROS
  category String   @default("OTROS")

  supplier      String? // proveedor
  supplierTaxId String?
  concept       String? @db.Text

  currency String @default("EUR") // EUR | USD
  // paymentMethod: STRIPE | TRANSFER | REMITTANCE | CARD | CASH | OTHER
  paymentMethod String @default("TRANSFER")
  // status: PENDING | PAID
  status        String @default("PAID")

  baseCents  Int   @default(0)
  taxRate    Float @default(21)
  taxCents   Int   @default(0)
  totalCents Int   @default(0)
  // Si el IVA es deducible (afecta a reporting fiscal).
  deductible Boolean @default(true)

  notes   String? @db.Text
  fileUrl String? // justificante/adjunto opcional

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issuer    InvoiceIssuer? @relation(fields: [issuerId], references: [id])

  @@index([workspaceId])
  @@index([issuerId])
  @@index([date])
}

// Contador de numeración por (workspace, tipo/serie, año). Garantiza
// numeración correlativa sin huecos por serie y año fiscal.
model InvoiceCounter {
  id          String @id @default(cuid())
  workspaceId String
  series      String // código de serie (p.ej. "FAC", "REC", "PRO", "PRE")
  year        Int
  next        Int    @default(1)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, series, year])
  @@index([workspaceId])
}

model Invoice {
  id          String @id @default(cuid())
  workspaceId String

  // type: NORMAL | RECTIFICATIVA | PROFORMA | PRESUPUESTO
  type   String @default("NORMAL")
  // status NORMAL/RECT/PROF: DRAFT | ISSUED | PAID | CANCELLED
  // status PRESUPUESTO:      DRAFT | SENT | ACCEPTED | REJECTED
  status String @default("DRAFT")

  // Número correlativo (p.ej. "FAC-2026-0001"). Se asigna al emitir.
  // Los borradores pueden tener number null hasta que se emiten.
  series String?
  number String?

  issuerId String?
  clientId String?

  // Snapshots de datos fiscales al emitir (no cambian si luego editas el
  // emisor/cliente). JSON con name, legalName, taxId, address, etc.
  issuerSnapshot Json?
  clientSnapshot Json?

  issueDate DateTime @default(now())
  dueDate   DateTime?

  currency String @default("EUR") // EUR | USD
  // paymentMethod: STRIPE | TRANSFER | REMITTANCE | CARD | CASH | OTHER
  paymentMethod String @default("STRIPE")

  // Líneas: [{ description, quantity, unitPriceCents, taxRate, discountPct }]
  lines Json

  // Totales en céntimos de la divisa (enteros, sin floats).
  subtotalCents Int @default(0)
  discountCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int @default(0)
  paidCents     Int @default(0)

  notes String? @db.Text
  terms String? @db.Text // pie legal / condiciones

  // Rectificativa: a qué factura rectifica y por qué.
  rectifiesInvoiceId String?
  rectifyReason      String?

  // Recurrencia: si recurring=true esta factura es una PLANTILLA que el
  // cron usa para generar facturas reales. recurrenceConfig:
  // { intervalMonths, dayOfMonth, nextRunAt, endsAt }
  recurring        Boolean @default(false)
  recurrenceConfig Json?
  // Si esta factura fue GENERADA por una plantilla recurrente, su id.
  recurringSourceId String?

  // Factura-e
  facturaeXml      String? @db.Text // XML generado (sin firma en fase 1)
  facturaeSignedAt DateTime?

  // Cobro
  stripePaymentLinkUrl String?
  paidAt               DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issuer    InvoiceIssuer? @relation(fields: [issuerId], references: [id])
  client    Client?        @relation(fields: [clientId], references: [id])

  @@unique([workspaceId, number])
  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([issueDate])
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole  @default(MEMBER)
  // features: lista explícita de herramientas que este miembro puede usar.
  // null = se aplican los defaults del rol (Admin todo, Member todos los
  // estándar, Guest sólo lectura). Array = sólo las herramientas listadas.
  // Se ignora para ADMIN (siempre tiene todo).
  features    Json?
  // adminGrants: acceso GRANULAR al panel de administración para usuarios
  // que NO son ADMIN. Forma: { sections: string[], cards: string[] } con las
  // ids de sección y los hrefs de tarjeta de lib/admin-catalog.ts. null/ausente
  // = sin acceso al panel admin. Se ignora para ADMIN (siempre ve todo). Las
  // tarjetas marcadas adminOnly nunca se conceden por esta vía.
  adminGrants Json?
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ====================================================================
// CRM (Clients & Contacts)
// ====================================================================

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  industry    String?
  status      ClientStatus @default(ACTIVE)
  contactName String?
  email       String?
  phone       String?
  mrr         Int          @default(0) // céntimos opcionalmente, aquí euros enteros
  since       DateTime?
  notes       String?      @db.Text
  asanaId     String?      @unique // trazabilidad migración

  // ----- Secciones nuevas del modal Editar cliente -----
  // Información general libre (sector ampliado, ubicación, horarios,
  // sucursales, tipo de empresa, etc.). Texto libre.
  infoGeneral String?         @db.Text
  // Accesos: URLs/usuarios/passwords del cliente (cPanel, WP, GMB,
  // Metricool, etc.). Texto libre por ahora; se podría cifrar en
  // futuro con encryptSecret() como hacemos con las API keys.
  accesos     String?         @db.Text
  // Servicios contratados. Array de slugs predefinidos:
  // "diseno_web" | "seo_web" | "seo_ia" | "gmb" | "sem" |
  // "gestion_redes" | "campana_redes" | "mantenimiento" |
  // "servidor" | "dominio"
  servicios   Json?
  // Bono Kit Digital (ayudas Red.es). Boolean para reporting.
  kitDigital  Boolean         @default(false)
  // Prioridad para el equipo interno (no es lo mismo que status).
  // ALTA → urgencia visual (rojo/rose en listados).
  // NORMAL → default.
  // BAJA → cliente de bajo mantenimiento (gris/verde).
  prioridad   ClientPrioridad @default(NORMAL)

  // ----- Editorial / NV Dashboard meta (migrado del plugin) -----
  // Brief & branding básico
  brandBrief         String? @db.Text
  website            String?
  brandColorPrimary  String  @default("#1F2937")
  brandColorAccent   String  @default("#2563EB")
  brandColorText     String  @default("#FFFFFF")
  // Logo
  logoUrl            String?
  logoPosition       String  @default("br") // br | bl | tr | tl
  // Patrón visual
  visualPattern      String  @default("clean") // clean | frame
  refsFidelity       Int     @default(50) // 0-100
  // Competidores (texto libre, URL/nombre por línea)
  competitors        String? @db.Text
  // Dimensiones por formato — JSON { imagen:{w,h,preset}, reel:{...}, ... }
  dimensionsByFormat Json?
  // Referencias visuales — JSON [{ url, type, personName }]
  referenceImages    Json?
  // Plantillas visuales subidas por el cliente — JSON
  // [{ id, url, name, notes? }]. Imágenes de ejemplo/layout que el
  // usuario puede elegir por publicación como guía de estilo para la IA.
  patternTemplates   Json?
  // Fuentes corporativas — JSON [{ url, name, weight }]
  fonts              Json?
  // Guía de estilo cacheada (generada por IA a partir de las refs visuales)
  styleGuideCached   String? @db.Text
  styleGuideHash     String?
  // Google Drive refs
  driveMode          String  @default("pending") // configured | pending | no_drive_refs
  driveRootId        String?
  driveSubfolders    Json? // [{ name, id, type }]
  // Modelo de imagen (override del default del workspace).
  // Valores: "openai-gpt-image-1" | "freepik-seedream-v4" | null = default
  imageModel         String?
  // Preset del modal "Generar mes con IA" para este cliente: count,
  // networks[], mix{}, copyLength, perNetworkCopy, extraGuidance,
  // status, generateImages, imageQuality. Si null usa los defaults
  // globales del modal.
  editorialDefaults  Json?
  // Negativo permanente de imagen: cosas/personas/objetos que NUNCA
  // deben aparecer en imágenes generadas para este cliente (free-text).
  // Se aplica automáticamente a TODAS las generaciones, incluso si el
  // user no rellena el cuadro de negativo en el modal.
  imageGlobalAvoid   String? @db.Text

  // ----- Meta Ads: vinculación cuenta/página por cliente -----
  // Cuando una tarea de campaña tiene clientId, Sonia resuelve estos
  // valores automáticamente (sin tener que pegar la URL del Ads Manager).
  // metaAdAccountId: id de la cuenta publicitaria (con o sin "act_").
  metaAdAccountId    String?
  // metaPageId: id de la página de Facebook que publicará los anuncios.
  metaPageId         String?
  // metaInstagramId: id de la cuenta de Instagram vinculada (opcional).
  metaInstagramId    String?
  // metaLeadEmails: emails (coma-separados) a los que avisar de leads.
  metaLeadEmails     String?

  // ----- Datos fiscales (para el gestor de facturas) -----
  // Razón social (si difiere del nombre comercial). taxId = NIF/CIF/VAT.
  legalName    String?
  taxId        String?
  fiscalAddress String?
  postalCode   String?
  city         String?
  province     String?
  countryCode  String? @default("ESP") // ISO 3166-1 alpha-3 (Facturae)
  // Customer de Stripe (para cobros vía payment link / remesa).
  stripeCustomerId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects       Project[]
  tasks          Task[]
  events         CalendarEvent[]
  editorialPosts EditorialPost[]
  deliverables   Deliverable[]
  aiMemory       AiClientMemory?
  aiOwnership    AiOwnership?
  aiWorkflows    AiClientWorkflow[]
  invoices       Invoice[]
  issuers        InvoiceIssuer[]    @relation("IssuerClients")

  @@index([workspaceId])
}

enum ClientStatus {
  ACTIVE
  PAUSED
  PROSPECT
  CHURNED
}

enum ClientPrioridad {
  ALTA
  NORMAL
  BAJA
}

// ====================================================================
// PROJECTS & TASKS
// ====================================================================

model Project {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String?
  name          String
  description   String?   @db.Text
  color         String    @default("bg-brand-500")
  // Emoji corto (1-4 chars) que precede al nombre del proyecto en
  // UI: tablones, sidebar, breadcrumbs. Mejora reconocimiento visual.
  // Si null, no se renderiza nada extra.
  emoji         String?
  // Usuario que GESTIONA este proyecto (manager / responsable). Se
  // muestra su avatar en la card del proyecto. Es independiente de
  // ProjectMember (que son los participantes): el manager es uno solo.
  managerUserId String?
  progress      Int       @default(0)
  archived      Boolean   @default(false)
  asanaId       String?   @unique
  // Columnas kanban específicas de este proyecto. Si null, se usan
  // las columnas globales del workspace (Workspace.settings.kanban.columns).
  // Cada item es { id, label, color, order, isDone? }, mismo shape
  // que las del workspace. La importación desde Asana las rellena
  // a partir de las secciones del proyecto.
  kanbanColumns Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  deletedById   String?

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager   User?           @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  tasks     Task[]
  taskLinks TaskProject[]
  members   ProjectMember[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([managerUserId])
}

// Membresía explícita por proyecto. Si una fila NO existe para (projectId, userId),
// el usuario no tiene acceso al proyecto, salvo que sea ADMIN del workspace
// (los admins ven y editan todo por defecto).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      UserRole @default(MEMBER) // rol DENTRO del proyecto
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ====================================================================
// REVIEWS GENERATOR (migrado de Generador de Reseñas IA PRO de WordPress)
// ====================================================================
model ReviewClient {
  id                String   @id @default(cuid())
  workspaceId       String
  slug              String // identificador URL-safe único por workspace
  name              String
  webUrl            String?
  // destinationUrl es OPCIONAL: lo usa el modo AI_GENERATOR (la web
  // a la que se manda al user para pegar el texto IA). En modo
  // STAR_REDIRECT se ignora y se usan positiveUrl/negativeUrl.
  // Por compatibilidad con registros existentes lo dejamos no-null
  // y los nuevos clientes en modo STAR_REDIRECT lo dejan en "" o
  // duplicado de positiveUrl.
  destinationUrl    String
  // Modo de funcionamiento del cliente público en /r/[slug]:
  //   AI_GENERATOR  → modo histórico: cliente cuenta su experiencia,
  //                   OpenAI redacta la reseña al estilo configurado,
  //                   y se le redirige a destinationUrl con el texto
  //                   listo para pegar.
  //   STAR_REDIRECT → modo "Automatic Choice": landing con 5 estrellas;
  //                   si elige 4-5 → positiveUrl (típicamente GMB);
  //                   si elige 1-3 → negativeUrl (form interno de la
  //                   agencia para captar feedback negativo SIN que
  //                   acabe en Google).
  mode              ReviewMode @default(AI_GENERATOR)
  // STAR_REDIRECT — destinos por puntuación.
  positiveUrl       String?
  negativeUrl       String?
  // Google Place ID — opcional, helper para auto-generar positiveUrl
  // con el formato de whitespark:
  //   https://search.google.com/local/writereview?placeid=<placeId>
  placeId           String?
  topics            String   @db.Text // un tema por línea (solo AI_GENERATOR)
  bannedWords       String? // separadas por coma (solo AI_GENERATOR)
  recommendedWords  String? // separadas por coma (solo AI_GENERATOR)
  extraInstructions String?  @db.Text // (solo AI_GENERATOR)
  model             String   @default("gpt-4o-mini")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  history   ReviewHistory[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

enum ReviewMode {
  AI_GENERATOR
  STAR_REDIRECT
}

model ReviewHistory {
  id        String   @id @default(cuid())
  clientId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  client ReviewClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ====================================================================
// VOICE REVIEWS (migrado del plugin Voice Reviews)
// ====================================================================
// ====================================================================
// EDITORIAL (migrado de NV Dashboard WP — calendario de publicaciones)
// ====================================================================
model EditorialPost {
  id             String    @id @default(cuid())
  workspaceId    String
  clientId       String?
  title          String
  content        String?   @db.Text
  excerpt        String?   @db.Text
  scheduledFor   DateTime?
  publishedAt    DateTime?
  status         String    @default("DRAFT") // DRAFT|REVIEW|APPROVED|SCHEDULED|PUBLISHED|ARCHIVED
  format         String? // post|reel|story|video|blog|email|carousel
  networks       String    @default("[]") // JSON array de redes destino
  thumbnail      String?
  mediaUrls      String    @default("[]") // JSON array
  // Copy distinto por red — JSON { instagram: "...", facebook: "...", ... }.
  // Si una red no aparece en el mapa, se usa `content` como fallback.
  copyByNetwork  Json?
  hashtags       String?   @db.Text // copy compartido de hashtags (no por red)
  firstComment   String?   @db.Text // primer comentario para Metricool
  // Plan visual estructurado generado JUNTO al copy por Claude (migrado
  // del plugin NV Dashboard). Permite que la imagen IA respete personas
  // del roster y el overlay de texto se componga limpio sin alucinaciones.
  // headlineLines: array de {text, size:sm|md|lg|xl, color:white|accent|primary, weight:regular|bold}
  headlineLines  Json?
  // imagePrompt: prompt en inglés para gpt-image-1, con descripción física
  // de personas mencionadas en copy, espacio negativo, "no readable text".
  imagePrompt    String?   @db.Text
  // textPlacement: top|center|bottom (lado opuesto a donde va la persona)
  textPlacement  String?
  // Patrón visual ELEGIDO para esta publicación (override del cliente).
  // key de VISUAL_PATTERNS (clean/frame/bold_blocks/...). Si null, usa
  // el del cliente.
  visualPattern  String?
  // % (0-100) de cuánto debe la IA aplicar el estilo del patrón al
  // generar la imagen. 0 = ignóralo, 100 = aplícalo al máximo.
  patternStrength Int?
  // id de una plantilla visual del cliente (patternTemplates) elegida
  // para esta publicación. Si está, la IA la usa como guía de estilo
  // (imagen de referencia) con intensidad patternStrength.
  patternTemplateId String?
  // Aspect ratio elegido por el usuario al crear el post (ej "1:1", "16:9",
  // "9:16", "4:3", "3:4", "2:3", "3:2", "2:1", "3:1", "21:9"). Null o "auto"
  // = derivado del formato según los defaults del cliente. La generación de
  // imagen/vídeo lo usa para fijar las dimensiones de la salida.
  aspectRatio    String?
  metaJson       Json? // resto de ACF / metadatos
  legacyWpId     Int?      @unique
  metricoolJobId String? // reservado para integración API directa (futura)
  lastExportedAt DateTime? // última vez que se incluyó en un export CSV/Metricool
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  revisions EditorialRevision[]
  messages  EditorialPostMessage[]

  @@index([workspaceId, status])
  @@index([clientId])
  @@index([scheduledFor])
}

// Mensajes de hilo en una pieza editorial. Permiten conversación
// inline entre cliente y equipo dentro del panel de aprobación.
// `authorType` distingue al cliente (sin login) del equipo (con
// User). Para el cliente, `authorId` es null y guardamos su nombre
// si lo proporciona el link público (típicamente lo dejamos en
// blanco y mostramos el nombre del cliente). Para el equipo,
// `authorId` apunta al User humano y `authorType="TEAM"`.
model EditorialPostMessage {
  id         String   @id @default(cuid())
  postId     String
  authorType String // "CLIENT" | "TEAM"
  authorId   String? // null para el cliente, User.id para el equipo
  authorName String? // fallback visible si authorId es null
  body       String   @db.Text
  // En el futuro: attachments, mentions a nivel de mensaje, etc.
  createdAt  DateTime @default(now())

  post   EditorialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([authorId])
}

model EditorialRevision {
  id            String   @id @default(cuid())
  postId        String
  authorId      String?
  body          String?  @db.Text
  changeSummary String?
  createdAt     DateTime @default(now())

  post EditorialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// Link público de aprobación que la agencia comparte con el cliente.
// El cliente entra sin login a /p/editorial/[token], ve las publicaciones
// del mes, puede aprobar/rechazar y dejar comentarios.
model ClientApprovalLink {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String
  token       String    @unique @default(cuid())
  month       String // YYYY-MM
  createdById String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId, month])
  @@index([token])
}

// Decisión / comentario del cliente desde el link público sobre una
// publicación concreta.
model ClientApprovalDecision {
  id        String   @id @default(cuid())
  linkId    String
  postId    String
  decision  String // approved | rejected | comment
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([linkId, postId])
  @@index([postId])
}

// ====================================================================
// NV LEADS PRO (migrado: Google Places + WhatsApp + secuencias)
// ====================================================================
model LeadSearch {
  id                 String    @id @default(cuid())
  workspaceId        String
  keyword            String
  location           String
  scope              String    @default("custom") // custom | spain (loop por provincias)
  /// Fuente de leads: "places" (Google Places) | "borme" | "trustpilot"
  /// | "doctoralia" | "idealista" | "fotocasa" | "linkedin". Cada fuente
  /// tiene su collector en lib/leads/sources/*.ts.
  source             String    @default("places")
  status             String    @default("PENDING") // PENDING|RUNNING|COMPLETED|FAILED
  provincesScope     String    @default("[]") // JSON array (legacy)
  totalProvinces     Int       @default(1)
  processedProvinces Int       @default(0)
  currentProvince    String?
  totalResults       Int       @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?   @db.Text
  legacyWpId         Int?      @unique
  // Si true: leads cuyo placeId YA exista en otra búsqueda del workspace
  // se saltan (búsqueda incremental + dedup cross-búsqueda). Se cuentan
  // aparte como `leadsSkipped` para informar al usuario.
  /// Configuración específica por fuente. P.ej. para "places":
  /// { lowRatingOnly: true, minReviewsCount: 5, maxRating: 3.5 }.
  /// JSON libre para no migrar cada vez que añadimos un filtro nuevo.
  sourceConfig       Json?
  skipExisting       Boolean   @default(false)
  leadsSkipped       Int       @default(0)
  // Monitorización continua: si true, el cron leads-monitor revisa
  // periódicamente esta búsqueda para detectar negocios nuevos y caídas de
  // rating, marcando esos leads como calientes.
  monitored          Boolean   @default(false)
  lastMonitoredAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@index([workspaceId, status])
  @@index([monitored])
}

model Lead {
  id                  String    @id @default(cuid())
  workspaceId         String
  searchId            String?
  placeId             String
  // Datos básicos del negocio (Google Places)
  name                String
  address             String?
  formattedAddress    String?
  province            String?
  phone               String?
  internationalPhone  String?
  website             String?
  // Email de contacto del negocio (extraído de su web / aviso legal). Para
  // listas de remarketing (subir como Custom Audience a Meta) — interés
  // legítimo B2B, con opt-out.
  email               String?
  category            String?
  types               Json?
  latitude            Float?
  longitude           Float?
  position            Int?
  gmbUrl              String?
  businessStatus      String?
  priceLevel          Int?
  // Reviews
  rating              Float?
  reviewsCount        Int       @default(0)
  reviewsJson         Json?
  positivePct         Float?
  negativePct         Float?
  neutralPct          Float?
  // Datos crudos completos del API
  rawData             Json?
  // Lead scorer (heurística)
  score               Int? // 0-100
  urgency             String? // critica | alta | media | baja | descartar
  scoreBreakdown      Json?
  // Ticket score: VALOR estimado del lead (sector premium, ya hace anuncios,
  // precio €€€, tamaño). Distinto del score de "dolor ahora". Para priorizar
  // captación de ticket alto.
  ticketScore         Int? // 0-100
  ticketTier          String? // premium | alto | medio | bajo
  // IA
  aiOpener            String?   @db.Text
  aiOpenerGeneratedAt DateTime?
  // WhatsApp
  hasWhatsapp         Boolean   @default(false)
  whatsappChecked     Boolean   @default(false)
  whatsappCheckedAt   DateTime?
  // Estado del contacto
  contactStatus       String    @default("pending") // pending|contacted|responded|client|excluded|discarded
  notes               String?   @db.Text
  // Si el lead se convirtió en cliente del Hub, su id (para enlazar y evitar
  // duplicar al pulsar "Convertir en cliente" más de una vez).
  convertedClientId   String?
  legacyWpId          Int?      @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace     Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  search        LeadSearch?              @relation(fields: [searchId], references: [id], onDelete: SetNull)
  competitors   LeadCompetitor[]
  assignments   LeadSequenceAssignment[]
  inboxMessages LeadInboxMessage[]
  messages      LeadMessage[]
  execOutreach  LeadExecOutreach[]

  @@unique([workspaceId, placeId])
  @@index([workspaceId, contactStatus])
  @@index([workspaceId, urgency])
  @@index([searchId])
  @@index([score])
  @@index([workspaceId, ticketScore])
}

// Cola de envío de mensajes (saliente). Cron procesa items con
// status="queued" y scheduledAt <= now respetando ventana y delays.
model LeadMessage {
  id                String    @id @default(cuid())
  workspaceId       String
  leadId            String
  templateId        String?
  renderedMessage   String    @db.Text
  channel           String    @default("whatsapp")
  instanceName      String? // sesión WAHA (default si null)
  phoneNormalized   String // E.164 sin +
  status            String    @default("queued") // queued|sending|sent|failed|delivered|read
  scheduledAt       DateTime?
  sentAt            DateTime?
  sendAttempts      Int       @default(0)
  lastError         String?   @db.Text
  externalMessageId String?
  priority          Int       @default(0)
  createdAt         DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([leadId, status])
  @@index([status, scheduledAt])
}

model LeadCompetitor {
  id           String  @id @default(cuid())
  leadId       String
  placeId      String?
  name         String
  position     Int
  rating       Float?
  reviewsCount Int     @default(0)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String   @db.Text
  channel     String   @default("whatsapp") // whatsapp|email|sms
  isDefault   Boolean  @default(false) // si true, entra en el pool de rotación
  legacyWpId  Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
}

model LeadSequence {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  active      Boolean  @default(true) // legacy: equivalente a isActive
  isDefault   Boolean  @default(false) // si true, se aplica automáticamente al crear lead
  legacyWpId  Int?     @unique
  createdAt   DateTime @default(now())

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       LeadSequenceStep[]
  assignments LeadSequenceAssignment[]

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
}

model LeadSequenceStep {
  id              String  @id @default(cuid())
  sequenceId      String
  order           Int
  delayHours      Int     @default(24)
  delayDays       Int     @default(1) // alias humano; cron mira delayHours/delayDays
  templateBody    String  @db.Text
  channel         String  @default("whatsapp")
  stopIfResponded Boolean @default(true)

  sequence LeadSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
}

model LeadSequenceAssignment {
  id            String    @id @default(cuid())
  leadId        String
  sequenceId    String
  status        String    @default("active") // active|paused|completed|stopped
  currentStep   Int       @default(0)
  nextRunAt     DateTime?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  stoppedReason String? // respuesta_recibida | manual | excluded | max_attempts

  lead     Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequence LeadSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([leadId, sequenceId])
  @@index([leadId])
  @@index([sequenceId])
  @@index([status, nextRunAt])
}

model LeadInboxMessage {
  id                       String   @id @default(cuid())
  workspaceId              String
  leadId                   String?
  fromPhone                String
  phoneNormalized          String? // alias E.164 sin +
  channel                  String   @default("whatsapp")
  direction                String   @default("in") // in | out
  body                     String   @db.Text
  meta                     Json?
  read                     Boolean  @default(false)
  externalMessageId        String?
  instanceName             String?
  // Acuse de recibo de WhatsApp para los mensajes SALIENTES (lo que envías
  // desde el inbox): -1 error · 0/1 enviado · 2 entregado al móvil · 3 leído ·
  // 4 reproducido. Es el "check de oro": prueba objetiva de que llegó.
  ack                      Int?
  ackAt                    DateTime?
  // Clasificación IA
  classification           String? // interested|objection|info_request|opt_out|off_topic|positive_no|auto_reply
  classificationConfidence Float?
  classificationReason     String?  @db.Text
  receivedAt               DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, read])
  @@index([workspaceId, classification])
  @@index([leadId])
  @@index([phoneNormalized])
}

// Patrones de exclusión por nombre (ej: cliente existente).
// Al crear un lead, si su nombre matchea, queda contactStatus=excluded.
model LeadExclusion {
  id          String   @id @default(cuid())
  workspaceId String
  matchType   String   @default("name") // name (futuro: domain, phone)
  matchValue  String
  matchMode   String   @default("contains") // contains | exact
  reason      String?
  // Legacy fields (compat con seed/import previo)
  placeId     String?
  phone       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, matchType])
}

/// Metadatos de una CONVERSACIÓN del inbox multi-WhatsApp (clave: teléfono
/// normalizado). displayName = pushName de WhatsApp capturado del webhook
/// (clave para reconocer contactos con LID, donde no hay teléfono legible);
/// note y priority los pone el usuario para organizar a quién atender antes.
model LeadConversationMeta {
  id          String   @id @default(cuid())
  workspaceId String
  phone       String // phoneNormalized de la conversación
  displayName String?
  note        String?  @db.Text
  priority    String   @default("none") // alta | media | baja | none
  status      String   @default("pending") // pending | followup | resolved
  archived    Boolean  @default(false)
  // Teléfono real resuelto desde WAHA cuando el contacto llega como LID (id
  // privado de WhatsApp). null = no resuelto / oculto.
  realPhone   String?
  // Recordatorio de seguimiento: cuándo volver a contactar. El cron
  // leads-followups avisa al llegar la hora y sube la conversación a
  // "followup". null = sin recordatorio.
  followupAt  DateTime?
  followupNote String?
  followupNotifiedAt DateTime?
  // Análisis IA de la conversación: probabilidad de cierre (0-100), su motivo
  // y un borrador de respuesta listo. Se recalcula al entrar un mensaje.
  aiScore     Int?
  aiScoreReason String?
  aiDraft     String?  @db.Text
  aiAt        DateTime?
  // Momento de comprar: la IA detecta alta intención (pregunta precio/cuándo,
  // urgencia) y marca aiCallNow=true con un guion de cierre por teléfono.
  aiCallNow   Boolean  @default(false)
  aiCallScript String? @db.Text
  // Auto-piloto de seguimiento: si un lead caliente se queda en silencio tras
  // nuestra última respuesta, la IA envía sola un follow-up con cadencia
  // decreciente (24h, 72h, 7d). step = nudges enviados; se reinicia a 0 cuando
  // el lead vuelve a escribir. autoFollowupOff lo desactiva para esta convo.
  autoFollowupStep   Int       @default(0)
  autoFollowupLastAt DateTime?
  autoFollowupOff    Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
}

/// Difusión segmentada: un mensaje que se envía a un segmento de
/// conversaciones existentes del inbox (filtradas por clasificación, estado o
/// prioridad). El envío va ESPACIADO (anti-baneo) — cada destinatario tiene su
/// scheduledAt encadenado y el cron entrega de uno en uno respetando la
/// ventana horaria y la cadencia mínima.
model LeadBroadcast {
  id          String   @id @default(cuid())
  workspaceId String
  body        String   @db.Text
  segment     Json? // filtros aplicados (classifications/statuses/priorities)
  total       Int      @default(0)
  sentCount   Int      @default(0)
  failedCount Int      @default(0)
  status      String   @default("running") // running | done | paused
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipients LeadBroadcastRecipient[]

  @@index([workspaceId, status])
}

model LeadBroadcastRecipient {
  id                String    @id @default(cuid())
  workspaceId       String
  broadcastId       String
  phone             String // phoneNormalized de la conversación
  chatId            String? // chatId original para responder (LID-aware)
  instanceName      String?
  leadId            String?
  body              String    @db.Text // texto ya personalizado para este contacto
  status            String    @default("queued") // queued | sent | failed | skipped
  scheduledAt       DateTime
  sentAt            DateTime?
  externalMessageId String?
  error             String?
  createdAt         DateTime  @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcast LeadBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, scheduledAt])
  @@index([broadcastId])
}

/// Secuencia multicanal de contacto a un DIRECTIVO: cadencia email (auto, vía
/// Resend) + recordatorios de LinkedIn/llamada (manuales, vía notificación).
/// El motor avanza un paso por tick respetando nextAt. Una por lead.
model LeadExecOutreach {
  id           String   @id @default(cuid())
  workspaceId  String
  leadId       String
  email        String? // destinatario corporativo
  directorName String?
  step         Int      @default(0)
  status       String   @default("active") // active | done | stopped
  nextAt       DateTime @default(now())
  log          Json? // pasos ejecutados [{at, channel, detail}]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, leadId])
  @@index([workspaceId, status, nextAt])
}

model LeadOptout {
  id          String   @id @default(cuid())
  workspaceId String
  phone       String
  leadId      String?
  reason      String?
  source      String   @default("manual") // manual | ai_classification
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
}

// ====================================================================
// AI USAGE TRACKING — cuánto cuesta cada proyecto/trabajador en IA
// ====================================================================
model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String? // usuario que disparó la llamada (null = API key sin user)
  projectId    String? // si la llamada está atada a un proyecto
  feature      String // "chat", "summarize", "redactor", "reviews", "voice_draft", etc.
  provider     String // "anthropic" | "openai"
  model        String // "claude-opus-4-7", "gpt-4o-mini", "whisper-1", etc.
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costMicros   Int      @default(0) // coste en micros de USD (1 USD = 1_000_000)
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

// ====================================================================
// BACKUPS
// ====================================================================
model BackupRun {
  id           String    @id @default(cuid())
  workspaceId  String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  status       String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  trigger      String    @default("manual") // manual | cron
  destinations String    @default("local") // CSV: "local,r2,drive"
  sizeBytes    Int?
  downloadKey  String? // s3Key en R2 si se subió allí
  errorMessage String?   @db.Text

  @@index([workspaceId, startedAt])
}

model VoiceBusiness {
  id            String   @id @default(cuid())
  workspaceId   String
  slug          String // identificador en /v/<slug>
  name          String
  location      String?
  googleUrl     String?
  trustpilotUrl String?
  introText     String?  @db.Text
  disclaimer    String?  @db.Text
  customPrompt  String?  @db.Text
  maxSeconds    Int      @default(30)
  aiProvider    String   @default("anthropic") // "anthropic" | "openai"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Task {
  id                String       @id @default(cuid())
  workspaceId       String
  projectId         String
  clientId          String?
  parentId          String? // subtareas
  title             String
  description       String?      @db.Text
  status            String       @default("TODO") // antes enum TaskStatus; ahora libre para soportar columnas custom del workspace
  priority          TaskPriority @default(MEDIUM)
  dueDate           DateTime?
  // false = la tarea tiene hora concreta (la hora viene en dueDate).
  // true (default) = solo fecha, sin hora; en el calendario se renderiza
  // como evento de día completo. Mantenido true por defecto para que
  // las tareas existentes no cambien de comportamiento.
  dueAllDay         Boolean      @default(true)
  completedAt       DateTime?
  order             Int          @default(0)
  asanaId           String?      @unique
  // URL pública del task en Asana (permalink_url de la API). Nos sirve
  // para que el equipo pueda ir al original durante la convivencia,
  // y para auditar la migración.
  asanaPermalink    String?
  // Custom fields de Asana (priority, status custom, etc.) preservados
  // tal cual los devuelve la API. La estructura es la que Asana usa:
  // [{ gid, name, type, enum_value, text_value, number_value, ... }].
  // Lo guardamos para que el equipo pueda consultarlo desde la UI
  // aunque todavía no haya UI dedicada para cada custom field.
  asanaCustomFields Json?
  // Tareas flash: checklist de minitareas [{id, text, done}] que también se
  // muestra en la tarjeta del kanban para marcarlas desde el panel general.
  flashTasks        Json?
  // Estado persistente de Sonia para esta task. Mapa de recursos
  // creados por la IA durante runs anteriores, para idempotencia:
  // si la task se re-ejecuta, en lugar de crear duplicados, reutiliza
  // lo registrado aquí. Estructura típica:
  // {
  //   meta_ads: { campaignId?, adsetId?, formId?, creativeId?, adId?, imageHash? },
  //   make: { scenarioId?, hookId? },
  //   editorial: { postId? },
  //   ...
  // }
  // Se vacía cuando un humano edita la task (PATCH /tasks/[id]).
  aiState           Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Soft delete. Si != null, el registro está en la papelera. Las
  // queries de UI filtran por `deletedAt: null`. La purga definitiva
  // la hace el cron /api/cron/trash-purge cuando supera la
  // retención (30 días por defecto).
  deletedAt         DateTime?
  deletedById       String?

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parent         Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks       Task[]         @relation("Subtasks")
  assignees      TaskAssignee[]
  tags           TaskTag[]
  // Proyectos EXTRA donde aparece la misma tarea. El proyecto principal
  // sigue siendo `projectId` (define la columna kanban canónica). Esta
  // tabla permite que la tarea aparezca también en los listados de
  // otros proyectos sin duplicar el registro.
  extraProjects  TaskProject[]
  // (Comment[] backref removido: la relación era polimórfica y
  // generaba FK constraints conflictivos contra Document. La query
  // de comentarios de una tarea se hace por targetType+targetId.)
  // Notificaciones por fecha de entrega — array de keys persistidas:
  // "day_7am", "1h_before", "10min_before". null = defaults
  // (todas activas). [] = ninguna. Sólo se programa el envío si la
  // tarea tiene dueDate.
  notifyDueRules Json?

  // Plantillas de tarea — si la task se creó desde un TaskTemplate,
  // referenciamos el id aquí. customData contiene los valores
  // rellenados para los custom fields definidos en la plantilla
  // (objeto plano { fieldId: value }). null = task sin plantilla.
  templateId String?
  customData Json?

  // Recurrencia: si la tarea debe relanzarse sola cada cierto tiempo
  // (sobre todo tareas de Sonia, para no relanzarlas a mano cada día).
  //   none | daily | every_2_days | weekly | biweekly | monthly
  recurrence       String    @default("none")
  // Próxima ejecución programada. El cron de recurrencia dispara un run
  // de Sonia cuando recurrenceNextAt <= now y avanza al siguiente slot.
  recurrenceNextAt DateTime?

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([recurrenceNextAt])
}

// Proyectos adicionales en los que aparece una tarea (multi-proyecto).
// La tarea sigue teniendo UN proyecto principal en Task.projectId; los
// extra van aquí. Pivot table simple.
model TaskProject {
  taskId    String
  projectId String
  // Estado/columna en ESTE proyecto extra. Una tarea con
  // proyecto principal A (status="EN_CURSO") puede aparecer en
  // proyecto B en cualquier columna distinta (p.ej. "REVISION").
  // Si null, en B aparece en la primera columna del proyecto.
  status    String?
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([taskId, projectId])
  @@index([projectId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  color       String    @default("bg-slate-200")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

// ====================================================================
// DOCUMENTS (Notion-like page tree with block-based content)
// ====================================================================

model Document {
  id          String    @id @default(cuid())
  workspaceId String
  parentId    String? // permite subpáginas anidadas
  title       String    @default("Sin título")
  icon        String? // emoji o nombre de icono Lucide
  cover       String?
  category    String?
  content     Json? // contenido TipTap (ProseMirror doc); null si usa blocks
  isTemplate  Boolean   @default(false)
  archived    Boolean   @default(false)
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Document?  @relation("Subpages", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("Subpages")
  blocks    Block[]
  // (Comment[] backref removido — ver nota en model Comment.)
  databases Database[] // un documento puede tener vista de DB inline

  @@index([workspaceId])
  @@index([parentId])
}

model Block {
  id         String    @id @default(cuid())
  documentId String
  parentId   String? // bloques anidados (toggles, columnas)
  type       BlockType
  content    Json // texto enriquecido + props del bloque
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   Block?   @relation("BlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Block[]  @relation("BlockChildren")

  @@index([documentId])
}

enum BlockType {
  PARAGRAPH
  HEADING_1
  HEADING_2
  HEADING_3
  BULLET_LIST
  NUMBERED_LIST
  TODO
  TOGGLE
  QUOTE
  CALLOUT
  CODE
  DIVIDER
  IMAGE
  VIDEO
  EMBED
  FILE
  TABLE
  COLUMNS
  PAGE_LINK
  DATABASE_VIEW
}

// ====================================================================
// DATABASES (Notion-style con propiedades + vistas)
// ====================================================================

model Database {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String? // si es inline en un documento
  name        String
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document   Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  properties DatabaseProperty[]
  records    DatabaseRecord[]
  views      DatabaseView[]
}

model DatabaseProperty {
  id         String          @id @default(cuid())
  databaseId String
  name       String
  type       PropertyType
  config     Json // opciones según tipo (select options, formula, etc.)
  order      Int             @default(0)
  database   Database        @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values     DatabaseValue[]

  @@unique([databaseId, name])
}

enum PropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  PERSON
  CHECKBOX
  URL
  EMAIL
  PHONE
  FILE
  RELATION
  ROLLUP
  FORMULA
  CREATED_TIME
  CREATED_BY
}

model DatabaseRecord {
  id         String   @id @default(cuid())
  databaseId String
  title      String   @default("Sin título")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  database Database        @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values   DatabaseValue[]

  @@index([databaseId])
}

model DatabaseValue {
  id         String           @id @default(cuid())
  recordId   String
  propertyId String
  value      Json // formato según PropertyType
  record     DatabaseRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  property   DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([recordId, propertyId])

// Prisma schema for Agencia Hub (Phase 2)
// Modelo multi-tenant: cada cuenta es un Workspace, con miembros (users)
// y todos los recursos llevan workspaceId para aislamiento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================================================================
// AUTH (NextAuth.js)
// ====================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  phone         String?   // para futuras notificaciones SMS/WhatsApp
  emailVerified DateTime?
  role          UserRole  @default(MEMBER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  projectMembers    ProjectMember[]
  ownedApiKeys      ApiKey[]
  asanaTokens       AsanaConnection[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  comments          Comment[]
  assignedTasks     TaskAssignee[]
}

enum UserRole {
  ADMIN
  MEMBER
  GUEST
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ====================================================================
// WORKSPACE & MEMBERSHIP
// ====================================================================

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  settings  Json?    // { ai: { anthropicApiKey: "...", defaultModel: "..." }, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  clients      Client[]
  projects     Project[]
  tasks        Task[]
  documents    Document[]
  databases    Database[]
  tags         Tag[]
  files        File[]
  events       CalendarEvent[]
  apiKeys      ApiKey[]
  webhooks     Webhook[]
  auditLogs    AuditLog[]
  asanaImports AsanaImport[]
  comments     Comment[]
  reviewClients   ReviewClient[]
  voiceBusinesses VoiceBusiness[]
  editorialPosts  EditorialPost[]
  approvalLinks   ClientApprovalLink[]
  credentialGrants CredentialAccessGrant[]
  leadSearches    LeadSearch[]
  leads           Lead[]
  leadTemplates   LeadTemplate[]
  leadSequences   LeadSequence[]
  leadInboxMsgs   LeadInboxMessage[]
  leadMessages    LeadMessage[]
  leadExclusions  LeadExclusion[]
  leadOptouts     LeadOptout[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole  @default(MEMBER)
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ====================================================================
// CRM (Clients & Contacts)
// ====================================================================

model Client {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  industry    String?
  status      ClientStatus @default(ACTIVE)
  contactName String?
  email       String?
  phone       String?
  mrr         Int          @default(0) // céntimos opcionalmente, aquí euros enteros
  since       DateTime?
  notes       String?      @db.Text
  asanaId     String?      @unique // trazabilidad migración

  // ----- Editorial / NV Dashboard meta (migrado del plugin) -----
  // Brief & branding básico
  brandBrief        String? @db.Text
  website           String?
  brandColorPrimary String  @default("#1F2937")
  brandColorAccent  String  @default("#2563EB")
  brandColorText    String  @default("#FFFFFF")
  // Logo
  logoUrl      String?
  logoPosition String  @default("br") // br | bl | tr | tl
  // Patrón visual
  visualPattern String @default("clean") // clean | frame
  refsFidelity  Int    @default(50) // 0-100
  // Competidores (texto libre, URL/nombre por línea)
  competitors String? @db.Text
  // Dimensiones por formato — JSON { imagen:{w,h,preset}, reel:{...}, ... }
  dimensionsByFormat Json?
  // Referencias visuales — JSON [{ url, type, personName }]
  referenceImages Json?
  // Fuentes corporativas — JSON [{ url, name, weight }]
  fonts Json?
  // Guía de estilo cacheada (generada por IA a partir de las refs visuales)
  styleGuideCached String? @db.Text
  styleGuideHash   String?
  // Google Drive refs
  driveMode        String  @default("pending") // configured | pending | no_drive_refs
  driveRootId      String?
  driveSubfolders  Json? // [{ name, id, type }]
  // Modelo de imagen (override del default del workspace).
  // Valores: "openai-gpt-image-1" | "freepik-seedream-v4" | null = default
  imageModel       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects       Project[]
  tasks          Task[]
  events         CalendarEvent[]
  editorialPosts EditorialPost[]

  @@index([workspaceId])
}

enum ClientStatus {
  ACTIVE
  PAUSED
  PROSPECT
  CHURNED
}

// ====================================================================
// PROJECTS & TASKS
// ====================================================================

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?
  name        String
  description String?  @db.Text
  color       String   @default("bg-brand-500")
  progress    Int      @default(0)
  archived    Boolean  @default(false)
  asanaId     String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tasks     Task[]
  members   ProjectMember[]

  @@index([workspaceId])
  @@index([clientId])
}

// Membresía explícita por proyecto. Si una fila NO existe para (projectId, userId),
// el usuario no tiene acceso al proyecto, salvo que sea ADMIN del workspace
// (los admins ven y editan todo por defecto).
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      UserRole @default(MEMBER) // rol DENTRO del proyecto
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ====================================================================
// REVIEWS GENERATOR (migrado de Generador de Reseñas IA PRO de WordPress)
// ====================================================================
model ReviewClient {
  id                   String   @id @default(cuid())
  workspaceId          String
  slug                 String   // identificador URL-safe único por workspace
  name                 String
  webUrl               String?
  destinationUrl       String   // Trustpilot / Google Business / etc.
  topics               String   @db.Text // un tema por línea
  bannedWords          String?  // separadas por coma
  recommendedWords     String?  // separadas por coma
  extraInstructions    String?  @db.Text
  model                String   @default("gpt-4o-mini")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  history   ReviewHistory[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model ReviewHistory {
  id        String   @id @default(cuid())
  clientId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  client ReviewClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ====================================================================
// VOICE REVIEWS (migrado del plugin Voice Reviews)
// ====================================================================
// ====================================================================
// EDITORIAL (migrado de NV Dashboard WP — calendario de publicaciones)
// ====================================================================
model EditorialPost {
  id            String    @id @default(cuid())
  workspaceId   String
  clientId      String?
  title         String
  content       String?   @db.Text
  excerpt       String?   @db.Text
  scheduledFor  DateTime?
  publishedAt   DateTime?
  status        String    @default("DRAFT") // DRAFT|REVIEW|APPROVED|SCHEDULED|PUBLISHED|ARCHIVED
  format        String?   // post|reel|story|video|blog|email|carousel
  networks      String    @default("[]") // JSON array de redes destino
  thumbnail     String?
  mediaUrls     String    @default("[]") // JSON array
  // Copy distinto por red — JSON { instagram: "...", facebook: "...", ... }.
  // Si una red no aparece en el mapa, se usa `content` como fallback.
  copyByNetwork Json?
  hashtags      String?   @db.Text // copy compartido de hashtags (no por red)
  firstComment  String?   @db.Text // primer comentario para Metricool
  metaJson      Json?     // resto de ACF / metadatos
  legacyWpId    Int?      @unique
  metricoolJobId String?  // reservado para integración API directa (futura)
  lastExportedAt DateTime? // última vez que se incluyó en un export CSV/Metricool
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  revisions EditorialRevision[]

  @@index([workspaceId, status])
  @@index([clientId])
  @@index([scheduledFor])
}

model EditorialRevision {
  id            String   @id @default(cuid())
  postId        String
  authorId      String?
  body          String?  @db.Text
  changeSummary String?
  createdAt     DateTime @default(now())

  post EditorialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// Link público de aprobación que la agencia comparte con el cliente.
// El cliente entra sin login a /p/editorial/[token], ve las publicaciones
// del mes, puede aprobar/rechazar y dejar comentarios.
model ClientApprovalLink {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  token       String   @unique @default(cuid())
  month       String // YYYY-MM
  createdById String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId, month])
  @@index([token])
}

// Decisión / comentario del cliente desde el link público sobre una
// publicación concreta.
model ClientApprovalDecision {
  id        String   @id @default(cuid())
  linkId    String
  postId    String
  decision  String // approved | rejected | comment
  comment   String? @db.Text
  createdAt DateTime @default(now())

  @@index([linkId, postId])
  @@index([postId])
}

// ====================================================================
// NV LEADS PRO (migrado: Google Places + WhatsApp + secuencias)
// ====================================================================
model LeadSearch {
  id                  String    @id @default(cuid())
  workspaceId         String
  keyword             String
  location            String
  scope               String    @default("custom") // custom | spain (loop por provincias)
  status              String    @default("PENDING") // PENDING|RUNNING|COMPLETED|FAILED
  provincesScope      String    @default("[]") // JSON array (legacy)
  totalProvinces      Int       @default(1)
  processedProvinces  Int       @default(0)
  currentProvince     String?
  totalResults        Int       @default(0)
  startedAt           DateTime?
  completedAt         DateTime?
  errorMessage        String?   @db.Text
  legacyWpId          Int?      @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@index([workspaceId, status])
}

model Lead {
  id                    String    @id @default(cuid())
  workspaceId           String
  searchId              String?
  placeId               String
  // Datos básicos del negocio (Google Places)
  name                  String
  address               String?
  formattedAddress      String?
  province              String?
  phone                 String?
  internationalPhone    String?
  website               String?
  category              String?
  types                 Json?
  latitude              Float?
  longitude             Float?
  position              Int?
  gmbUrl                String?
  businessStatus        String?
  priceLevel            Int?
  // Reviews
  rating                Float?
  reviewsCount          Int       @default(0)
  reviewsJson           Json?
  positivePct           Float?
  negativePct           Float?
  neutralPct            Float?
  // Datos crudos completos del API
  rawData               Json?
  // Lead scorer (heurística)
  score                 Int?      // 0-100
  urgency               String?   // critica | alta | media | baja | descartar
  scoreBreakdown        Json?
  // IA
  aiOpener              String?   @db.Text
  aiOpenerGeneratedAt   DateTime?
  // WhatsApp
  hasWhatsapp           Boolean   @default(false)
  whatsappChecked       Boolean   @default(false)
  whatsappCheckedAt     DateTime?
  // Estado del contacto
  contactStatus         String    @default("pending") // pending|contacted|responded|client|excluded|discarded
  notes                 String?   @db.Text
  legacyWpId            Int?      @unique
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  search        LeadSearch?        @relation(fields: [searchId], references: [id], onDelete: SetNull)
  competitors   LeadCompetitor[]
  assignments   LeadSequenceAssignment[]
  inboxMessages LeadInboxMessage[]
  messages      LeadMessage[]

  @@unique([workspaceId, placeId])
  @@index([workspaceId, contactStatus])
  @@index([workspaceId, urgency])
  @@index([searchId])
  @@index([score])
}

// Cola de envío de mensajes (saliente). Cron procesa items con
// status="queued" y scheduledAt <= now respetando ventana y delays.
model LeadMessage {
  id                  String    @id @default(cuid())
  workspaceId         String
  leadId              String
  templateId          String?
  renderedMessage     String    @db.Text
  channel             String    @default("whatsapp")
  instanceName        String?   // sesión WAHA (default si null)
  phoneNormalized     String    // E.164 sin +
  status              String    @default("queued") // queued|sending|sent|failed|delivered|read
  scheduledAt         DateTime?
  sentAt              DateTime?
  sendAttempts        Int       @default(0)
  lastError           String?   @db.Text
  externalMessageId   String?
  priority            Int       @default(0)
  createdAt           DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([leadId, status])
  @@index([status, scheduledAt])
}

model LeadCompetitor {
  id           String   @id @default(cuid())
  leadId       String
  placeId      String?
  name         String
  position     Int
  rating       Float?
  reviewsCount Int      @default(0)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String   @db.Text
  channel     String   @default("whatsapp") // whatsapp|email|sms
  isDefault   Boolean  @default(false) // si true, entra en el pool de rotación
  legacyWpId  Int?     @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
}

model LeadSequence {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  active      Boolean  @default(true) // legacy: equivalente a isActive
  isDefault   Boolean  @default(false) // si true, se aplica automáticamente al crear lead
  legacyWpId  Int?     @unique
  createdAt   DateTime @default(now())

  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       LeadSequenceStep[]
  assignments LeadSequenceAssignment[]

  @@index([workspaceId])
  @@index([workspaceId, isDefault])
}

model LeadSequenceStep {
  id              String  @id @default(cuid())
  sequenceId      String
  order           Int
  delayHours      Int     @default(24)
  delayDays       Int     @default(1) // alias humano; cron mira delayHours/delayDays
  templateBody    String  @db.Text
  channel         String  @default("whatsapp")
  stopIfResponded Boolean @default(true)

  sequence LeadSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
}

model LeadSequenceAssignment {
  id              String    @id @default(cuid())
  leadId          String
  sequenceId      String
  status          String    @default("active") // active|paused|completed|stopped
  currentStep     Int       @default(0)
  nextRunAt       DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  stoppedReason   String?   // respuesta_recibida | manual | excluded | max_attempts

  lead     Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequence LeadSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([leadId, sequenceId])
  @@index([leadId])
  @@index([sequenceId])
  @@index([status, nextRunAt])
}

model LeadInboxMessage {
  id                       String   @id @default(cuid())
  workspaceId              String
  leadId                   String?
  fromPhone                String
  phoneNormalized          String? // alias E.164 sin +
  channel                  String   @default("whatsapp")
  direction                String   @default("in") // in | out
  body                     String   @db.Text
  meta                     Json?
  read                     Boolean  @default(false)
  externalMessageId        String?
  instanceName             String?
  // Clasificación IA
  classification           String? // interested|objection|info_request|opt_out|off_topic|positive_no|auto_reply
  classificationConfidence Float?
  classificationReason     String?  @db.Text
  receivedAt               DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, read])
  @@index([workspaceId, classification])
  @@index([leadId])
  @@index([phoneNormalized])
}

// Patrones de exclusión por nombre (ej: cliente existente).
// Al crear un lead, si su nombre matchea, queda contactStatus=excluded.
model LeadExclusion {
  id          String   @id @default(cuid())
  workspaceId String
  matchType   String   @default("name") // name (futuro: domain, phone)
  matchValue  String
  matchMode   String   @default("contains") // contains | exact
  reason      String?
  // Legacy fields (compat con seed/import previo)
  placeId     String?
  phone       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, matchType])
}

model LeadOptout {
  id          String   @id @default(cuid())
  workspaceId String
  phone       String
  leadId      String?
  reason      String?
  source      String   @default("manual") // manual | ai_classification
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
}

// ====================================================================
// AI USAGE TRACKING — cuánto cuesta cada proyecto/trabajador en IA
// ====================================================================
model AiUsage {
  id            String   @id @default(cuid())
  workspaceId   String
  userId        String?  // usuario que disparó la llamada (null = API key sin user)
  projectId     String?  // si la llamada está atada a un proyecto
  feature       String   // "chat", "summarize", "redactor", "reviews", "voice_draft", etc.
  provider      String   // "anthropic" | "openai"
  model         String   // "claude-opus-4-7", "gpt-4o-mini", "whisper-1", etc.
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  costMicros    Int      @default(0) // coste en micros de USD (1 USD = 1_000_000)
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

// ====================================================================
// BACKUPS
// ====================================================================
model BackupRun {
  id            String   @id @default(cuid())
  workspaceId   String
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  status        String   @default("RUNNING") // RUNNING | COMPLETED | FAILED
  trigger       String   @default("manual")  // manual | cron
  destinations  String   @default("local")   // CSV: "local,r2,drive"
  sizeBytes     Int?
  downloadKey   String?  // s3Key en R2 si se subió allí
  errorMessage  String?  @db.Text

  @@index([workspaceId, startedAt])
}

model VoiceBusiness {
  id              String   @id @default(cuid())
  workspaceId     String
  slug            String   // identificador en /v/<slug>
  name            String
  location        String?
  googleUrl       String?
  trustpilotUrl   String?
  introText       String?  @db.Text
  disclaimer      String?  @db.Text
  customPrompt    String?  @db.Text
  maxSeconds      Int      @default(30)
  aiProvider      String   @default("anthropic") // "anthropic" | "openai"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String
  clientId    String?
  parentId    String?      // subtareas
  title       String
  description String?      @db.Text
  status      String       @default("TODO")  // antes enum TaskStatus; ahora libre para soportar columnas custom del workspace
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  order       Int          @default(0)
  asanaId     String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  parent    Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]         @relation("Subtasks")
  assignees TaskAssignee[]
  tags      TaskTag[]
  comments  Comment[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskAssignee {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([taskId, userId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("bg-slate-200")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([taskId, tagId])
}

// ====================================================================
// DOCUMENTS (Notion-like page tree with block-based content)
// ====================================================================

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?  // permite subpáginas anidadas
  title       String   @default("Sin título")
  icon        String?  // emoji o nombre de icono Lucide
  cover       String?
  category    String?
  content     Json?    // contenido TipTap (ProseMirror doc); null si usa blocks
  isTemplate  Boolean  @default(false)
  archived    Boolean  @default(false)
  authorId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Document?  @relation("Subpages", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[] @relation("Subpages")
  blocks    Block[]
  comments  Comment[]
  databases Database[] // un documento puede tener vista de DB inline

  @@index([workspaceId])
  @@index([parentId])
}

model Block {
  id         String    @id @default(cuid())
  documentId String
  parentId   String?   // bloques anidados (toggles, columnas)
  type       BlockType
  content    Json      // texto enriquecido + props del bloque
  order      Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parent   Block?   @relation("BlockChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Block[]  @relation("BlockChildren")

  @@index([documentId])
}

enum BlockType {
  PARAGRAPH
  HEADING_1
  HEADING_2
  HEADING_3
  BULLET_LIST
  NUMBERED_LIST
  TODO
  TOGGLE
  QUOTE
  CALLOUT
  CODE
  DIVIDER
  IMAGE
  VIDEO
  EMBED
  FILE
  TABLE
  COLUMNS
  PAGE_LINK
  DATABASE_VIEW
}

// ====================================================================
// DATABASES (Notion-style con propiedades + vistas)
// ====================================================================

model Database {
  id          String   @id @default(cuid())
  workspaceId String
  documentId  String?  // si es inline en un documento
  name        String
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document   Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  properties DatabaseProperty[]
  records    DatabaseRecord[]
  views      DatabaseView[]
}

model DatabaseProperty {
  id         String       @id @default(cuid())
  databaseId String
  name       String
  type       PropertyType
  config     Json         // opciones según tipo (select options, formula, etc.)
  order      Int          @default(0)
  database   Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values     DatabaseValue[]

  @@unique([databaseId, name])
}

enum PropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  PERSON
  CHECKBOX
  URL
  EMAIL
  PHONE
  FILE
  RELATION
  ROLLUP
  FORMULA
  CREATED_TIME
  CREATED_BY
}

model DatabaseRecord {
  id         String          @id @default(cuid())
  databaseId String
  title      String          @default("Sin título")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  database   Database        @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  values     DatabaseValue[]

  @@index([databaseId])
}

model DatabaseValue {
  id         String   @id @default(cuid())
  recordId   String
  propertyId String
  value      Json     // formato según PropertyType
  record     DatabaseRecord   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  property   DatabaseProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([recordId, propertyId])
}

model DatabaseView {
  id         String       @id @default(cuid())
  databaseId String
  name       String
  type       ViewType
  config     Json         // filtros, ordenación, agrupación, columnas visibles
  order      Int          @default(0)
  database   Database     @relation(fields: [databaseId], references: [id], onDelete: Cascade)
}

enum ViewType {
  TABLE
  BOARD
  CALENDAR
  TIMELINE
  GALLERY
  LIST
}

// ====================================================================
// COMMENTS & MENTIONS (polimórficos)
// ====================================================================

model Comment {
  id          String      @id @default(cuid())
  workspaceId String
  authorId    String
  targetType  CommentTarget
  targetId    String
  body        String      @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "Comment_task_fk")
  document  Document? @relation(fields: [targetId], references: [id], onDelete: Cascade, map: "Comment_doc_fk")

  @@index([targetType, targetId])
}

enum CommentTarget {
  TASK
  DOCUMENT
  CLIENT
  PROJECT
}

// ====================================================================
// FILES & ATTACHMENTS (MinIO/S3)
// ====================================================================

model File {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  mimeType    String
  sizeBytes   Int
  s3Key       String   // ruta dentro del bucket
  targetType  String?  // TASK | DOCUMENT | CLIENT | …
  targetId    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([targetType, targetId])
}

// ====================================================================
// CALENDAR
// ====================================================================

model CalendarEvent {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?
  title       String
  description String?  @db.Text
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  type        EventType @default(MEETING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

enum EventType {
  PUBLICATION
  MEETING
  DEADLINE
  CAMPAIGN
  OTHER
}

// ====================================================================
// API KEYS, WEBHOOKS, AUDIT
// ====================================================================

model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?  // null si es key de servicio
  name        String
  prefix      String   @unique
  hashed      String   // bcrypt
  scopes      String[] // ej: ["clients:read", "tasks:write"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secret      String
  events      String[] // ej: ["task.created", "task.updated"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?
  attempts   Int      @default(0)
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  @@index([webhookId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String   // ej: "task.created"
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
  @@index([createdAt])
}

// ====================================================================
// NOTIFICATIONS
// ====================================================================

// Token de acceso temporal de un solo uso para que un admin comparta
// con el equipo de soporte (Claude) un volcado de credenciales.
// Generado por admin, válido típicamente 1h y consumido en la primera
// lectura (single-use). Auditable.
model CredentialAccessGrant {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedFromIp  String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, read])
}

// Reportes automáticos de errores producidos en el frontend o backend.
// Capturados por window.onerror + unhandledrejection + fetch wrapper en
// cliente, y por catch blocks en los endpoints en servidor.
//
// Cuando se crea un ErrorReport, opcionalmente se abre una GitHub Issue
// en el repo del proyecto (si hay GITHUB_TOKEN configurado).
//
// El ErrorReport se cierra cuando un commit referencia su id en el
// mensaje (ej: "fix: ... closes ErrorReport#abc123").
// Jobs en segundo plano (generación masiva de mes editorial, etc.). Se
// usan para no bloquear la respuesta HTTP cuando la operación tarda y el
// proxy de Railway corta a los 30-60s.
model BackgroundJob {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  kind        String    // editorial.generate_month | leads.search_batch | ...
  status      String    @default("PENDING") // PENDING|RUNNING|COMPLETED|FAILED|CANCELLED
  progressPct Int       @default(0) // 0-100
  progressMsg String?   // mensaje legible "Generando publicación 3/14"
  request     Json?     // params originales
  result      Json?     // payload de éxito
  errorCode   String?
  errorMessage String?  @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, kind, status])
  @@index([workspaceId, createdAt])
}

model ErrorReport {
  id              String    @id @default(cuid())
  workspaceId     String?
  userId          String?
  source          String    // client | server | api
  status          String    @default("REPORTED") // REPORTED | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | DISMISSED
  message         String    @db.Text
  stack           String?   @db.Text
  url             String?   // URL donde ocurrió
  userAgent       String?
  context         Json?     // info extra (params, body, etc.)
  fingerprint     String?   // hash para agrupar errores parecidos
  count           Int       @default(1) // veces que se ha repetido este fingerprint
  githubIssueUrl  String?   // si se abrió issue automática
  resolutionNote  String?   @db.Text
  resolutionCommit String?  // SHA del commit que lo resolvió
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([fingerprint])
  @@index([status, createdAt])
}

// Suscripciones Web Push del usuario (un usuario puede tener varias:
// portátil, móvil, tablet, navegadores distintos).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   @db.Text
  authKey   String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================================================================
// ASANA MIGRATION
// ====================================================================

model AsanaConnection {
  id           String   @id @default(cuid())
  userId       String
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  asanaUserId  String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AsanaImport {
  id          String   @id @default(cuid())
  workspaceId String
  status      String   // PENDING | RUNNING | COMPLETED | FAILED
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  stats       Json?    // { projects: 12, tasks: 340, attachments: 18, ... }
  errorMsg    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model DatabaseView {
  id         String   @id @default(cuid())
  databaseId String
  name       String
  type       ViewType
  config     Json // filtros, ordenación, agrupación, columnas visibles
  order      Int      @default(0)
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
}

enum ViewType {
  TABLE
  BOARD
  CALENDAR
  TIMELINE
  GALLERY
  LIST
}

// ====================================================================
// COMMENTS & MENTIONS (polimórficos)
// ====================================================================

model Comment {
  id          String        @id @default(cuid())
  workspaceId String
  authorId    String
  targetType  CommentTarget
  targetId    String
  // `body` se mantiene como String por compatibilidad con
  // comentarios antiguos importados de Asana (texto plano) y para
  // que la búsqueda LIKE de SQL siga funcionando sin un GIN sobre
  // un Json. Cuando hay rich text, también se persiste el doc
  // TipTap completo en `bodyJson`. Las lecturas priorizan bodyJson
  // si existe. Lazy migration: al primer GET de un comentario
  // legacy se parsea body y se rellena bodyJson en background.
  body        String        @db.Text
  bodyJson    Json?
  // GID de la "story" original de Asana cuando este comentario viene
  // de una importación. UNIQUE para idempotencia: si re-ejecutas
  // el import, los ya migrados se saltan en lugar de duplicarse.
  asanaId     String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Nota: `targetId` es polimórfico (apunta a Task, Document, Client
  // o Project según `targetType`). NO añadimos FK constraint porque
  // Prisma exigiría que el id exista en TODAS las relaciones a la
  // vez, lo que es imposible para un campo polimórfico — fallaba al
  // crear un comentario de tarea porque la BD evaluaba también el
  // FK contra Document. La integridad referencial se asegura en
  // código (cada handler valida el target antes de crear el comment).
  // La columna `targetId` queda como simple índice.

  @@index([targetType, targetId])
}

enum CommentTarget {
  TASK
  DOCUMENT
  CLIENT
  PROJECT
}

// ====================================================================
// FILES & ATTACHMENTS (MinIO/S3)
// ====================================================================

model File {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  mimeType    String
  sizeBytes   Int
  s3Key       String // ruta dentro del bucket
  targetType  String? // TASK | DOCUMENT | CLIENT | …
  targetId    String?
  uploadedBy  String?
  // GID del attachment original de Asana cuando este archivo viene
  // de una importación. UNIQUE para idempotencia.
  asanaId     String?  @unique
  createdAt   DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]

  @@index([workspaceId])
  @@index([targetType, targetId])
}

// ====================================================================
// CALENDAR
// ====================================================================

model CalendarEvent {
  id                String    @id @default(cuid())
  workspaceId       String
  clientId          String?
  title             String
  description       String?   @db.Text
  startAt           DateTime
  endAt             DateTime?
  allDay            Boolean   @default(false)
  type              EventType @default(MEETING)
  // Sincronización bidireccional con Google Calendar. Cuando un evento
  // nace en el Hub y se empuja a Google, guardamos su id remoto.
  // Cuando un evento viene de Google al sincronizar, también. El par
  // (googleCalendarId, googleEventId) identifica únicamente un evento
  // en Google. `googleOwnerUserId` apunta al user del Hub que tiene
  // la conexión OAuth con la que se sincroniza este evento.
  googleEventId     String?
  googleCalendarId  String?
  googleOwnerUserId String?
  lastSyncedAt      DateTime?
  // Si el evento nació de una gestión por teléfono de Sonia (reserva/cita),
  // queda ligado a la VoiceCall para confirmarlo/actualizarlo cuando llega
  // la transcripción de la llamada por webhook.
  voiceCallId       String?
  // Dueño del evento a efectos de PRIVACIDAD. null = evento compartido del
  // workspace (visible para todos, comportamiento por defecto). Si está
  // puesto, es un evento PERSONAL (p.ej. una reunión que Sonia añadió a
  // petición de un usuario) y solo lo ve ese usuario en su calendario.
  ownerUserId       String?
  // Marca de cuándo se envió el recordatorio push previo al evento (idempotencia).
  reminderSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([googleCalendarId, googleEventId])
  @@index([googleOwnerUserId])
  @@index([ownerUserId])
}

enum EventType {
  PUBLICATION
  MEETING
  DEADLINE
  CAMPAIGN
  OTHER
}

// ====================================================================
// API KEYS, WEBHOOKS, AUDIT
// ====================================================================

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String? // null si es key de servicio
  name        String
  prefix      String    @unique
  hashed      String // bcrypt
  scopes      String[] // ej: ["clients:read", "tasks:write"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secret      String
  events      String[] // ej: ["task.created", "task.updated"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  response   String?
  attempts   Int      @default(0)
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String // ej: "task.created"
  targetType  String?
  targetId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([createdAt])
}

// ====================================================================
// NOTIFICATIONS
// ====================================================================

// Token de acceso temporal de un solo uso para que un admin comparta
// con el equipo de soporte (Claude) un volcado de credenciales.
// Generado por admin, válido típicamente 1h y consumido en la primera
// lectura (single-use). Auditable.
model CredentialAccessGrant {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  usedFromIp  String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ===================================================================
// Sonia — Agente autónomo (Fase 1)
// ===================================================================
// Cada vez que una Task se enlaza con el proyecto "buzón" de Sonia
// (configurado en Workspace.settings.aiAgent.inboxProjectId) se crea
// un AiAgentRun en estado PENDING. El cron /api/cron/ai-agent/process
// los recoge y ejecuta un agent loop de Claude con tools acotadas
// (Fase 1: read-only + comentar + cambiar estado + marcar done).
//
// log: array de steps {type, ts, tool?, input?, output?, text?, error?}
//   para auditoría completa de cada acción. Permite revisar EXACTAMENTE
//   qué hizo la IA antes de aprobar acciones más sensibles en Fase 2.
//
// requesterId: el user que disparó el run (al añadir la tarea al
//   buzón IA). Se notifica al terminar.
model AiAgentRun {
  id            String              @id @default(cuid())
  workspaceId   String
  taskId        String
  requesterId   String? // user que enlazó la task al proyecto IA
  status        AiAgentRunStatus    @default(PENDING)
  trigger       AiAgentRunTrigger   @default(MANUAL)
  // Contexto extra del trigger (ej: "vence en 36h", "lleva 8 días
  // sin actividad"). Se inyecta en el primer mensaje al modelo.
  triggerContext String?            @db.Text
  // Fase 50: timestamp del último ciclo del loop. El runner lo
  // actualiza cada vez que vuelve de una llamada al modelo. Un
  // watchdog cron marca como REQUIRES_HUMAN los RUNNING que no
  // hacen tick en >10 min (proceso muerto: deploy, crash, OOM).
  lastIterationAt DateTime?
  // Modelo usado (por si en el futuro queremos elegir Haiku/Sonnet/Opus)
  model         String              @default("claude-opus-4-7")
  summary       String?             @db.Text // resumen final de la IA al user
  error         String?             @db.Text
  log           Json                @default("[]") // steps
  stepsCount    Int                 @default(0)
  inputTokens   Int                 @default(0)
  outputTokens  Int                 @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  // Φ — UI: cuándo un humano "revisó" el resultado de este run. Mientras
  // sea null y status sea SUCCEEDED/REQUIRES_HUMAN, la task parpadea
  // verde/naranja en el tablón. Se rellena automáticamente al editar la
  // task (PATCH significa que el humano la atendió) o vía endpoint manual.
  humanReviewedAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([taskId])
}

enum AiAgentRunStatus {
  PENDING       // creado, esperando worker
  RUNNING       // agent loop en marcha
  SUCCEEDED     // terminó OK, resumen disponible
  FAILED        // error fatal (timeout, tokens, exception)
  REQUIRES_HUMAN // la IA pidió ayuda — la tarea queda en mano del user
}

// Φ5 — Asistencia en vivo durante videollamadas. La extensión Chrome
// graba en chunks; cada chunk se envía a backend, se transcribe con
// Whisper, se procesa con Claude en modo "asistente en vivo", y se
// devuelven sugerencias contextuales (búsquedas, action items, tone
// alerts) que la extensión muestra como overlay flotante.
//
// Al terminar la reunión se crea una task normal con el transcript
// completo + resumen + action items extraídos.
model LiveMeetingSession {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String // quien arrancó la sesión
  taskId          String? // task creada al finalizar
  platform        String // "meet" | "teams" | "zoom" | ...
  meetingUrl      String?
  meetingTitle    String?
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  status          String   @default("LIVE") // LIVE | ENDED | FAILED
  // Append-only — concat del texto de cada chunk transcrito.
  fullTranscript  String   @default("") @db.Text
  // Append-only — { ts, chunkIdx, transcript, suggestions[] }
  suggestionsLog  Json     @default("[]")
  // Para throttling — cuándo procesamos la última vez con Claude.
  lastProcessedAt DateTime?
  chunksReceived  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([userId])
}

// Φ3 — Negociación autónoma. Sonia gestiona deals con leads/clientes
// dentro de rangos pre-aprobados por el admin.
model PricingService {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String // "Diseño web", "Gestión RRSS mensual", etc.
  description   String?   @db.Text
  baseAmountEur Float // precio "lista" en EUR
  minAmountEur  Float // mínimo aceptable — Sonia no baja de aquí sin escalación
  unit          String    @default("one_time") // "one_time" | "monthly" | "hourly"
  // Trade-offs que Sonia puede ofrecer durante la negociación.
  // Json shape: [{ if: "discount_pct >= 15", then: "min_term_months >= 12" }]
  // o simple lista de items: ["compromiso 12m", "sin módulo X", "pago 100% upfront"]
  tradeoffs     Json      @default("[]")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

model Deal {
  id              String   @id @default(cuid())
  workspaceId     String
  leadId          String? // si conocemos el Lead en BD
  clientId        String? // si ya es cliente nuestro (upsell)
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  status          String   @default("PROSPECT")
  // PROSPECT | PROPOSED | NEGOTIATING | CLOSED_WON | CLOSED_LOST | ESCALATED
  proposedItems   Json     @default("[]") // [{ serviceId, name, units, amountEur, unit }]
  negotiationLog  Json     @default("[]") // [{ ts, actor, action, snapshot }]
  currentValueEur Float?
  // Estado libre — lo que llevamos negociado en lenguaje natural,
  // para que Sonia lo lea sin parsear el log entero.
  notes           String?  @db.Text
  expectedCloseAt DateTime?
  closedAt        DateTime?
  closedReason    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([leadId])
  @@index([clientId])
}

enum AiAgentRunTrigger {
  MANUAL              // user enlazó la task al proyecto buzón
  MENTION             // @nv-ia en un comentario
  PROACTIVE_DEADLINE  // cron detectó deadline cercana sin progreso
  PROACTIVE_STALE     // cron detectó task estancada (IN_PROGRESS sin updates)
  SCHEDULED           // cron diario de revisión global
  WHATSAPP_INBOUND    // llegó WhatsApp de cliente vía /leads/webhook
  EMAIL_INBOUND       // llegó email vía /api/webhooks/inbound-email
  CALL_INBOUND        // llamada telefónica recibida (Twilio/Vonage/Aircall)
  STRATEGIC_REVIEW    // Co-CEO trimestral (Fase 40)
  OWNER_MODE_CHECK    // Owner mode: cliente bajo responsabilidad de Sonia (Fase 31)
  COMPLIANCE_FLAG     // Filtro de compliance bloqueó algo (Fase 36)
  LEAD_OPPORTUNITY    // Detección de señal de oportunidad (Fase 35)
  WORKFLOW_STEP       // Paso de un workflow automático (Fase 41)
  CHURN_RISK          // Señal de fuga de cliente detectada (Fase 43)
  SELF_HEALING        // Cron de auto-mejora detectó patrón de fallos (Fase 44)
  NEGOTIATION        // Lead/cliente en proceso de negociación (Φ3)
  LIVE_MEETING_TICK  // Tick de transcripción en vivo durante meeting (Φ5)
}

// Fase 41 — Workflows automáticos por cliente.
// Cuando se ficha un cliente nuevo (o se promueve un lead) se
// arranca un workflow tipo "onboarding 7 días" que ejecuta pasos
// programados: día 0 email bienvenida, día 1 recolectar info, día 3
// primer entregable, día 7 reunión check-in. Cada paso es una task
// en el inbox de Sonia con trigger=WORKFLOW_STEP.
model AiClientWorkflow {
  id            String   @id @default(cuid())
  workspaceId   String
  clientId      String
  // Tipo del workflow (clave para buscar la definición en code):
  // "onboarding_7d", "renewal_30d", "churn_recovery_14d", custom...
  workflowType  String
  // Plantilla de pasos como Json: [{ id, label, dayOffset, prompt }].
  // Se copia desde la definición en code al crear (snapshot — si
  // cambia la plantilla, los workflows ya iniciados no se ven afectados).
  steps         Json     @default("[]")
  // Índice del próximo paso a ejecutar (0-based).
  nextStepIdx   Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | ABANDONED
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([clientId])
}

// Fase 8: memoria persistente que Sonia acumula sobre cada cliente
// a través de los runs. Notas tipo:
//   - Preferencias confirmadas (cliente prefiere tono formal)
//   - Decisiones tomadas (acordamos usar Notion en lugar de Confluence)
//   - Rechazos previos (no le gustó que mencionáramos competencia)
//   - Restricciones (no contactar en horario de oficina)
//
// content es markdown plano. La IA o el admin lo edita; lo guardamos
// con cap de 50KB — si crece más, los apends viejos se truncan con
// marca. Cada actualización registra updatedBy ("nv-ia" o userId).
// Fase 31: Owner mode — Sonia es RESPONSABLE de un cliente con KPIs
// medibles. El cron OWNER_MODE_CHECK la dispara periódicamente (default
// semanal) para que revise estado, identifique desviaciones, escale.
model AiOwnership {
  id            String   @id @default(cuid())
  workspaceId   String
  clientId      String   @unique
  // KPIs en formato libre — la IA los lee/interpreta. Ej:
  // { responseTimeHours: 2, monthlyEngagement: ">5%", escalationCap: 1 }
  kpis          Json     @default("{}")
  // Cada cuánto revisa (default 7 días)
  checkFreqDays Int      @default(7)
  lastCheckAt   DateTime?
  // Último estado conocido (resumen breve de la última revisión)
  lastStatus    String?  @db.Text
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

model AiClientMemory {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String   @unique
  content     String   @db.Text @default("")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Fase 18: si autoApproveDraftKinds tiene valores (ej:
  // ["WHATSAPP", "EMAIL"]), los drafts de Sonia sobre tareas de
  // este cliente y de ese kind se auto-aprueban + ejecutan sin
  // esperar revisión humana. Solo activable manualmente por admin
  // tras observar tasa de aprobación alta. Sin esto = comportamiento
  // por defecto (todo draft requiere aprobación).
  autoApproveDraftKinds String[] @default([])

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Fase 34: Sonia puede PROPONER nuevas tools cuando detecta patrones
// repetitivos. NO se ejecutan automáticamente — el admin revisa el
// código TypeScript propuesto, lo añade manualmente a tools.ts si
// le parece bien, y Sonia gana una capacidad nueva.
//
// La IA escribe:
//   - name: "send_invoice_reminder" (snake_case)
//   - description: para qué sirve
//   - input_schema: JSON Schema de los args
//   - executorPseudoCode: pseudocódigo o TS describiendo qué debería
//     hacer la tool (consulta a BD, llamada a API, etc.). NO se
//     ejecuta — es input para el dev humano que la implementa.
//   - rationale: por qué la pide, qué runs/tareas se beneficiarían
model AiProposedTool {
  id              String   @id @default(cuid())
  workspaceId     String
  proposedByRunId String? // qué AiAgentRun la propuso
  name            String
  description     String   @db.Text
  inputSchema     Json
  executorPseudoCode String @db.Text
  rationale       String   @db.Text
  status          String   @default("PROPOSED") // PROPOSED | APPROVED | REJECTED | IMPLEMENTED
  reviewedById    String?
  reviewedAt      DateTime?
  reviewerNote    String?  @db.Text
  // Si el admin la marca IMPLEMENTED, anota el commit o referencia
  // donde quedó añadida al código.
  implementationRef String?
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

// Fase 17: memoria GLOBAL del workspace — políticas, firma estándar,
// horario, dirección, todo lo que aplica a TODA la comunicación.
// Una sola fila por workspace.
model AiWorkspaceMemory {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  content     String   @db.Text @default("")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Fase 17: memoria por MIEMBRO del equipo — sus áreas, horarios,
// preferencias. Sonia la usa al decidir a quién delegar.
model AiUserMemory {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  content     String   @db.Text @default("")
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

// Fase 2: borradores generados por Sonia que necesitan aprobación
// humana antes de ejecutarse (envío real de email/WhatsApp, creación
// de un post editorial, etc). Filosofía: la IA escribe el borrador,
// el humano lo lee, lo edita si quiere, y aprueba. Solo entonces se
// hace la acción irreversible.
//
// payload (Json) contiene el shape específico del tipo de draft:
//   - EMAIL:           { to, subject, html, text? }
//   - WHATSAPP:        { phoneNormalized, text, clientId? }
//   - EDITORIAL_POST:  { title, content, networks[], scheduledFor?, ... }
//
// executionResult: respuesta del backend al ejecutar (ej. messageId
//   de Resend, gid del post creado), o el error si falló.
model AiDraft {
  id              String         @id @default(cuid())
  workspaceId     String
  aiAgentRunId    String? // run que lo creó (null si lo creó admin a mano)
  taskId          String? // tarea de origen (opcional — drafts pueden venir de tareas IA)
  kind            AiDraftKind
  title           String // resumen humano-legible para la lista de aprobación
  payload         Json
  status          AiDraftStatus  @default(PENDING)
  reviewedById    String? // user que aprobó/rechazó
  reviewedAt      DateTime?
  reviewerNote    String?        @db.Text
  executedAt      DateTime?
  executionResult Json? // { ok: true, externalId: "..." } | { ok: false, error: "..." }
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([taskId])
  @@index([aiAgentRunId])
}

enum AiDraftKind {
  EMAIL
  WHATSAPP
  EDITORIAL_POST
  CALENDAR_EVENT
  DRIVE_FILE
  HOLDED_INVOICE
  HOLDED_QUOTE
  STRIPE_PAYMENT_LINK
  PHONE_CALL // llamada de voz (Vapi) propuesta; se ejecuta al aprobar
  CUSTOM // texto libre — para acciones que aún no tienen integración
}

enum AiDraftStatus {
  PENDING     // recién creado, esperando review
  APPROVED    // aprobado pero aún no ejecutado (race window)
  REJECTED    // descartado, no se ejecuta
  EXECUTED    // ejecutado con éxito
  FAILED      // intentó ejecutarse y falló — admin puede reintentar
}

// Reportes automáticos de errores producidos en el frontend o backend.
// Capturados por window.onerror + unhandledrejection + fetch wrapper en
// cliente, y por catch blocks en los endpoints en servidor.
//
// Cuando se crea un ErrorReport, opcionalmente se abre una GitHub Issue
// en el repo del proyecto (si hay GITHUB_TOKEN configurado).
//
// El ErrorReport se cierra cuando un commit referencia su id en el
// mensaje (ej: "fix: ... closes ErrorReport#abc123").
// Jobs en segundo plano (generación masiva de mes editorial, etc.). Se
// usan para no bloquear la respuesta HTTP cuando la operación tarda y el
// proxy de Railway corta a los 30-60s.
model BackgroundJob {
  id              String    @id @default(cuid())
  workspaceId     String
  userId          String?
  kind            String // editorial.generate_month | leads.search_batch | ...
  status          String    @default("PENDING") // PENDING|RUNNING|COMPLETED|FAILED|CANCELLED
  progressPct     Int       @default(0) // 0-100
  progressMsg     String? // mensaje legible "Generando publicación 3/14"
  request         Json? // params originales
  result          Json? // payload de éxito
  // Log de eventos del job para el toast expandible. Array de
  // { ts, level: "info"|"warn"|"error", message, durationMs? }.
  events          Json?
  // Prompts enviados a Claude (system + user) — auditoría de "qué le
  // pedí exactamente al modelo". Sólo aplica a kinds de IA editorial.
  systemPrompt    String?   @db.Text
  userPrompt      String?   @db.Text
  // Bandera de cancelación cooperativa. El loop del job la mira entre
  // iteraciones y para limpiamente, conservando lo ya creado.
  cancelRequested Boolean   @default(false)
  errorCode       String?
  errorMessage    String?   @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId, kind, status])
  @@index([workspaceId, createdAt])
}

model ErrorReport {
  id               String    @id @default(cuid())
  workspaceId      String?
  userId           String?
  source           String // client | server | api
  status           String    @default("REPORTED") // REPORTED | ACKNOWLEDGED | IN_PROGRESS | RESOLVED | DISMISSED
  message          String    @db.Text
  stack            String?   @db.Text
  url              String? // URL donde ocurrió
  userAgent        String?
  context          Json? // info extra (params, body, etc.)
  fingerprint      String? // hash para agrupar errores parecidos
  count            Int       @default(1) // veces que se ha repetido este fingerprint
  githubIssueUrl   String? // si se abrió issue automática
  resolutionNote   String?   @db.Text
  resolutionCommit String? // SHA del commit que lo resolvió
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([workspaceId, status])
  @@index([fingerprint])
  @@index([status, createdAt])
}

// Suscripciones Web Push del usuario (un usuario puede tener varias:
// portátil, móvil, tablet, navegadores distintos).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   @db.Text
  authKey   String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())
  lastSeen  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ====================================================================
// ASANA MIGRATION
// ====================================================================

model AsanaConnection {
  id             String    @id @default(cuid())
  // Históricamente se acumulaban duplicados porque saveAsanaToken hacía
  // findFirst+update y dejaba huérfanos; sin orderBy, findFirst después
  // elegía no-determinísticamente una u otra (síntoma: "modo automático"
  // funcionaba para workspaces pero fallaba con 401 al listar projects
  // porque cada llamada cogía una fila distinta). saveAsanaToken hace
  // deleteMany+create desde mid-2026, y getActiveAsanaConnection() limpia
  // duplicados al leer. Pendiente: añadir @@unique([userId]) cuando se
  // confirme que no hay duplicados legacy en producción.
  userId         String
  // `accessToken` quedó como texto plano por una iteración temprana.
  // Lo mantenemos para no romper conexiones existentes, pero los
  // tokens nuevos se cifran en `accessTokenEnc` con encryptSecret().
  // El helper de lectura prefiere accessTokenEnc; si solo hay
  // accessToken, lo migra cifrándolo en el primer uso.
  accessToken    String    @db.Text
  accessTokenEnc String?   @db.Text
  refreshToken   String?   @db.Text
  expiresAt      DateTime?
  asanaUserId    String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AsanaImport {
  id          String    @id @default(cuid())
  workspaceId String
  status      String // PENDING | RUNNING | COMPLETED | FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  // Latido del background job: el importer actualiza este campo cada
  // pocas operaciones. Si el UI ve status=RUNNING pero lastHeartbeatAt
  // > 5 min sin actualizar, sabe que el proceso ha muerto (deploy,
  // crash, OOM) y muestra "atascado — puedes relanzar".
  lastHeartbeatAt DateTime?
  // Etapa actual en lenguaje humano: "Leyendo usuarios de Asana",
  // "Importando tareas (proyecto 3/12)", "Subiendo adjuntos", etc.
  // El UI lo muestra para que el user vea QUÉ está haciendo, no solo
  // contadores.
  currentStage String?
  stats       Json? // { projects: 12, tasks: 340, attachments: 18, ... }
  errorMsg    String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ====================================================================
// Equipo: vacaciones + chat grupal
// ====================================================================

// Un día de vacaciones marcado por un trabajador. Granularidad por día
// (no por hora). Si la fecha ya pasó, queda lockedAt != null y no se
// puede modificar/borrar — se considera registro histórico.
model VacationDay {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  date        DateTime  @db.Date
  note        String?
  // Marca cuándo se "selló" el registro porque la fecha ya pasó. Si es
  // null, todavía es modificable. La capa de aplicación lo rellena en
  // el primer acceso después de que la fecha haya pasado.
  lockedAt    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, date])
  @@index([workspaceId, date])
}

// Chat grupal del equipo. Un solo "canal" por workspace por ahora; si
// más adelante hace falta multi-canal se añade channelId.
model TeamMessage {
  id          String   @id @default(cuid())
  workspaceId String
  authorId    String
  body        String   @db.Text
  // Lista opcional de referencias del tipo {kind:"task"|"project", id:"..."}
  // para deep-links a tareas/proyectos. Se rellena al parsear el body.
  references  Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// Registro de notificaciones de tarea ya enviadas, para no duplicar.
// Una fila por (taskId, ruleKey, userId). El cron crea estas filas
// dentro de la misma transacción que envía el email; si reintenta y
// ya existe, salta.
model TaskNotificationSent {
  taskId  String
  ruleKey String
  userId  String
  sentAt  DateTime @default(now())

  @@id([taskId, ruleKey, userId])
  @@index([sentAt])
}

// ====================================================================
// DELIVERABLES — entregables genéricos para aprobación del cliente
// ====================================================================
//
// Un "entregable" es cualquier pieza que la agencia entrega al cliente
// y que requiere su visto bueno: un PDF de propuesta, un mockup, un
// vídeo, un audio, etc. A diferencia de EditorialPost (que es
// específico de redes sociales), Deliverable es agnóstico: el cliente
// solo aprueba o pide cambios.
//
// El archivo en sí vive en File (storage R2/S3); Deliverable apunta
// con `fileId` (nullable porque a veces se crea el slot antes de
// adjuntar el archivo final).
model Deliverable {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String
  fileId      String?
  title       String
  description String?   @db.Text
  status      String    @default("PENDING") // PENDING|APPROVED|REJECTED
  dueAt       DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  file      File?                 @relation(fields: [fileId], references: [id], onDelete: SetNull)
  decisions DeliverableDecision[]

  @@index([workspaceId, status])
  @@index([clientId])
}

model DeliverableDecision {
  id            String   @id @default(cuid())
  deliverableId String
  decision      String // "approved" | "rejected" | "comment"
  comment       String?  @db.Text
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, createdAt])
}

// ====================================================================
// GOOGLE CALENDAR — integración bidireccional por usuario
// ====================================================================
//
// A diferencia de UserExternalCalendar (que es read-only vía iCal),
// esta tabla guarda los tokens OAuth para hacer push y pull contra
// el API de Google Calendar. Tokens cifrados con encryptSecret().
//
// `syncToken` es el cursor incremental que Google nos devuelve tras
// cada listado. La próxima llamada usa ese token y Google solo nos
// manda lo cambiado. Si Google lo invalida (sucede tras 30 días sin
// uso o si revocas permiso), reseteamos a null y hacemos full sync.
//
// `calendarId` por ahora siempre = "primary" del usuario; en un
// futuro se puede ampliar a múltiples calendarios por user.
model GoogleCalendarConnection {
  id                 String    @id @default(cuid())
  userId             String
  workspaceId        String
  googleAccountEmail String
  calendarId         String    @default("primary")
  // Tokens cifrados con lib/ai/crypto.ts:encryptSecret
  accessTokenEnc     String    @db.Text
  refreshTokenEnc    String    @db.Text
  expiresAt          DateTime
  // Cursor de sync incremental Google Calendar API
  syncToken          String?   @db.Text
  // Direcciones permitidas: por defecto bidi. Si el user quiere
  // solo importar (sin que sus cambios pisen Google), pone pushEnabled=false.
  pullEnabled        Boolean   @default(true)
  pushEnabled        Boolean   @default(true)
  lastSyncedAt       DateTime?
  lastError          String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  watchChannels GoogleCalendarWatchChannel[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Cuenta de correo IMAP/SMTP por usuario (ej. info@negociovivo.com en
// hosting propio cPanel). Sonia puede leer/buscar/enviar correos SOLO
// en nombre del usuario dueño de esta cuenta, y SOLO cuando ese mismo
// usuario se lo pide desde su sesión (gating en chat-tools por
// api.userId). La contraseña (idealmente una "app password") se guarda
// cifrada con lib/ai/crypto.ts.
model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  workspaceId  String
  email        String // info@negociovivo.com
  // IMAP (lectura)
  imapHost     String
  imapPort     Int      @default(993)
  imapSecure   Boolean  @default(true)
  // SMTP (envío)
  smtpHost     String
  smtpPort     Int      @default(465)
  smtpSecure   Boolean  @default(true)
  // Usuario de login (suele ser el email completo) + password cifrada
  loginUser    String
  passwordEnc  String   @db.Text
  lastError    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User      @relation("UserEmailAccounts", fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}
// Cada fila representa el vector de embedding de una entidad (tarea,
// cliente, proyecto, documento, comentario). Lo almacenamos como Json
// en lugar de usar pgvector para no obligar a habilitar la extensión
// PostgreSQL — el cálculo de cosine similarity se hace en memoria al
// buscar. Aceptable hasta ~50k filas; si crece más, se migra a
// pgvector con un script de re-indexación.
//
// `entityType` es el modelo origen (TASK, CLIENT, PROJECT, DOCUMENT,
// COMMENT). `entityId` su id. Garantizamos UNIQUE por (entityType,
// entityId) para que cada entidad tenga un solo vector vigente.
//
// `text` es el texto preprocesado que generó el vector, lo guardamos
// para mostrar snippet en los resultados y para detectar si ya
// reflejaba el contenido actual (skip si no ha cambiado).
//
// `model` permite migrar entre modelos sin destruir índices —
// guardamos qué modelo generó este vector y, al buscar, sólo
// comparamos contra vectores del mismo modelo. Cuando se cambia el
// modelo default, las filas viejas se re-indexan progresivamente.
model SearchEmbedding {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String // "TASK" | "CLIENT" | "PROJECT" | "DOCUMENT" | "COMMENT"
  entityId    String
  text        String   @db.Text
  embedding   Json // number[] (1536 floats para text-embedding-3-small)
  model       String   @default("text-embedding-3-small")
  tokens      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([workspaceId, entityType])
  @@index([workspaceId, model])
}

// Canales de notificación push de Google Calendar API. Cada canal
// es la suscripción "avísame en esta URL cuando cambie algo" contra
// el calendario de la conexión. Google los corta a los 30 días max,
// así que hay que renovar antes de que expiren (cron diario).
//
// `channelId` es el UUID que enviamos a Google al crear el canal;
// `resourceId` es lo que Google nos devuelve y lo necesitamos para
// hacer channels.stop. `token` es el secreto compartido que Google
// nos reenvía en cada webhook (cabecera X-Goog-Channel-Token); lo
// usamos para validar que el webhook viene del canal que esperamos.
model GoogleCalendarWatchChannel {
  id           String   @id @default(cuid())
  connectionId String
  channelId    String   @unique
  token        String
  resourceId   String
  expiration   DateTime
  createdAt    DateTime @default(now())

  connection GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([expiration])
}

// ====================================================================
// CAMPAÑA REDES IA — planificador y ejecutor de campañas en Meta Ads
// ====================================================================
//
// Workflow alto nivel:
//   1) El user rellena un wizard con todo el setup (token, fanpage,
//      tipo de campaña, conjuntos, segmentación, nº de anuncios…).
//   2) MetaCampaign se guarda como DRAFT con la config completa.
//   3) Se crea automáticamente una Task con todo el detalle + links.
//   4) (Fase 2) La IA expande la segmentación y propone copy+imagen
//      por cada MetaAd → preview → user aprueba.
//   5) (Fase 2) Llamada a Meta Marketing API: crea campaign, ad sets,
//      ads; rellena los xxxId de Meta y pasa el status a ACTIVE.
//   6) (Fase 3) En reviewAt el cron pide informe a la IA.
//
// El token de Meta se cifra con NEXTAUTH_SECRET (encryptSecret).

// Fase 52 — Google Ads. La API exige OAuth2 refresh_token (a obtener
// vía consentimiento del user en una cuenta Google con acceso al
// adsAccount), customer_id (la cuenta Google Ads a consultar) y un
// developer_token de la app (env var compartido por todo el server).
// loginCustomerId opcional: necesario solo si gestionas la cuenta
// desde un MCC (manager account).
model GoogleAdsConnection {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  refreshTokenEnc    String   @db.Text
  customerId         String // "1234567890" sin guiones
  loginCustomerId    String? // si gestionas desde un MCC
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MetaConnection {
  id             String    @id @default(cuid())
  workspaceId    String
  userId         String
  // Token de larga duración del usuario de Meta. Cifrado.
  accessTokenEnc String    @db.Text
  // Opcional: id de la cuenta de Meta del user (no del business).
  metaUserId     String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns MetaCampaign[]

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum MetaCampaignStatus {
  DRAFT // creada en Hub pero todavía no enviada a Meta
  PENDING_REVIEW // user pidió generar copys/imágenes, pendiente de su aprobación
  APPROVED // user dio el visto bueno a previews
  LAUNCHING // enviando a Meta API
  ACTIVE // ya en Meta, corriendo
  PAUSED
  COMPLETED
  FAILED // error al crear en Meta — ver lastError
}

enum MetaCampaignObjective {
  LEADS // clientes potenciales
  TRAFFIC // tráfico
  ENGAGEMENT
  CONVERSIONS
  AWARENESS
  SALES
  APP_PROMOTION
  VIDEO_VIEWS
  REACH
}

enum MetaLeadDestination {
  INSTANT_FORM // formularios instantáneos en Meta
  WEBSITE // formulario en web propia
  MESSENGER
  WHATSAPP
  PHONE_CALL
}

enum MetaAdsetMode {
  COLD_ONLY // 1 conjunto público frío
  COLD_PLUS_REMARKETING // 2 conjuntos
  CUSTOM // user define cuántos y a quién va cada uno
}

model MetaCampaign {
  id          String  @id @default(cuid())
  workspaceId String
  // Opcional — campaña ligada a un cliente del CRM. Útil para que
  // aparezca en la ficha del cliente y para imputar costes.
  clientId    String?
  // User que la creó / asignado de la campaña ("el que va a
  // generar la campaña" en el spec del user).
  ownerId     String

  // Identidad y descripción
  name        String
  description String? @db.Text // "público objetivo, contexto, briefing…"

  // Datos básicos del setup
  metaConnectionId String? // de qué conexión / token sale
  adsManagerUrl    String? // URL de business.facebook.com/adsmanager — para el sidebar
  fanpageUrl       String?
  fanpageName      String?

  // Programación y presupuesto
  startDate        DateTime
  endDate          DateTime? // null si "sin fecha de finalización"
  dailyBudgetCents Int // en céntimos para evitar floats

  // Objetivo + destino (este último solo aplica si LEADS)
  objective       MetaCampaignObjective
  leadDestination MetaLeadDestination?

  // Aprobación políticas Meta (legal)
  metaPoliciesAccepted   Boolean   @default(false)
  metaPoliciesAcceptedAt DateTime?

  // Conjuntos de anuncios
  adsetMode  MetaAdsetMode
  adsetCount Int           @default(1)

  // Segmentación libre que la IA expandirá en Fase 2.
  // En `expandedSegmentation` queda el JSON ya digerido (intereses,
  // edades, comportamientos…) listo para Meta.
  segmentationRaw      String @db.Text
  expandedSegmentation Json?

  // Geo
  locationsIncluded String[] // p.ej. ["Madrid", "Barcelona", "ES"]
  locationsExcluded String[]

  // Quién genera el contenido visual: VISUAL_BY_USER el user los sube,
  // VISUAL_BY_AI los genera gpt-image-1 / gpt-image-2.
  visualMode MetaVisualMode

  // Para campañas de LEAD con INSTANT_FORM: preguntas propuestas por
  // IA, aprobadas por el user. Cada item: { question, type, required, options? }
  formQuestions           Json?
  formQuestionsApprovedAt DateTime?

  // Emails que reciben los leads (para el escenario de Make)
  leadEmails String[]

  // Cuándo el cron debe pedir informe a la IA.
  reviewAt     DateTime?
  reviewSentAt DateTime?

  // Estado + integración con Meta
  status         MetaCampaignStatus @default(DRAFT)
  metaCampaignId String?            @unique // id real en Meta tras crear
  makeScenarioId String? // id del escenario de Make creado en Fase 3
  // Task generada en /tareas al crear — link bidireccional para que
  // borrar la campaña pueda limpiar la task (o viceversa).
  taskId         String?

  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  // Logo de la marca (1 URL en R2) — la IA lo coloca como footer del
  // anuncio si está presente.
  logoUrl String?
  // Imágenes de referencia (productos, brand visuals, fotos de equipo)
  // que la IA toma como inspiración estilística para el creativo. Hasta
  // 5 URLs en R2. Pasadas al modelo via image-to-image (gpt-image-2 con
  // /v1/images/edits).
  referenceImageUrls String[]
  // Sliders / preferencias que el user fija ANTES de generar — se
  // mezclan con el imagePrompt para sesgar el estilo del anuncio.
  //   { attentionLevel: 1-5,    // 1=discreto, 5=ultra llamativo
  //     toneFormality: 1-5,     // 1=tuteo cercano, 5=usted formal
  //     energyLevel: 1-5,       // 1=calmado, 5=urgente
  //     styleHint: string }     // editorial|casual|corporate|playful|luxurious
  generationSettings Json?

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metaConnection MetaConnection?      @relation(fields: [metaConnectionId], references: [id], onDelete: SetNull)
  adsets         MetaAdset[]
  reviews        MetaCampaignReview[]

  @@index([workspaceId, status])
  @@index([clientId])
  @@index([ownerId])
  @@index([reviewAt])
}

enum MetaVisualMode {
  USER_UPLOADS
  AI_GENERATES
}

// Conjunto de anuncios. Define la audiencia y el subpresupuesto si
// procede. La cantidad de MetaAd dentro depende del wizard.
model MetaAdset {
  id            String  @id @default(cuid())
  campaignId    String
  // "público frío", "remarketing 30d", "custom: lookalike 1% IT"
  label         String
  // Para CUSTOM: descripción del público objetivo concreto. La IA la
  // expande igual que la segmentación de la campaña.
  audienceBrief String? @db.Text
  metaAdsetId   String? @unique // tras crear en Meta

  ads      MetaAd[]
  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

enum MetaAdFormat {
  IMAGE
  CAROUSEL
  VIDEO
}

enum MetaAdContentStatus {
  PLACEHOLDER // aún no se ha generado nada
  GENERATING // llamada a OpenAI / freepik en curso
  READY_FOR_REVIEW
  APPROVED
  PUBLISHED
  FAILED
}

// Cada anuncio individual. Para CAROUSEL, mediaUrls tendrá 2-10 entradas.
model MetaAd {
  id             String              @id @default(cuid())
  adsetId        String
  format         MetaAdFormat
  // Copy generado por la IA o tecleado a mano.
  headline       String?
  primaryText    String?             @db.Text
  description    String?
  callToAction   String? // p.ej. "LEARN_MORE", "SIGN_UP"
  destinationUrl String?
  // URLs en R2 — para IMAGE: 1 elemento (square); CAROUSEL: 2-10
  // (square); VIDEO: 1. Es el formato canónico usado de fallback /
  // legacy. Las variantes específicas por placement viven en
  // mediaVariants (ver abajo).
  mediaUrls      String[]
  // Variantes de la imagen para los distintos placements de Meta.
  // Para IMAGE: { square: url, portrait: url, landscape: url }.
  // Para CAROUSEL: [ {square,portrait,landscape}, ... ] (1 entrada
  // por tarjeta). Para VIDEO: null.
  //   - square    1024x1024  → Feed (móvil + desktop, Instagram)
  //   - portrait  1024x1536  → Stories, Reels, Feed 4:5
  //   - landscape 1536x1024  → Columna derecha desktop, Marketplace,
  //                            Audience Network
  // Sin este campo la UI solo mostraba la cuadrada recortada y el
  // user no podía ver el anuncio completo ni cómo se vería en cada
  // placement antes de lanzar.
  mediaVariants  Json?
  // Instrucciones libres del user para regenerar ("hazla más colorida")
  userNotes      String?             @db.Text
  contentStatus  MetaAdContentStatus @default(PLACEHOLDER)
  metaAdId       String?             @unique
  lastError      String?             @db.Text

  adset MetaAdset @relation(fields: [adsetId], references: [id], onDelete: Cascade)

  @@index([adsetId])
}

// Snapshot de cómo iba la campaña en una fecha concreta. Lo genera
// el cron en reviewAt y queda registrado para histórico.
model MetaCampaignReview {
  id                String    @id @default(cuid())
  campaignId        String
  generatedAt       DateTime  @default(now())
  // Stats que sacamos de Meta API en ese momento.
  metrics           Json
  // Resumen + recomendaciones de la IA.
  summary           String    @db.Text
  recommendations   Json?
  autoFixOffered    Boolean   @default(false)
  autoFixAcceptedAt DateTime?
  autoFixResult     Json?

  campaign MetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, generatedAt])
}

// ====================================================================
// AI AGENT — MEMORIA PERSISTENTE (lecciones aprendidas)
//
// Cada vez que Sonia descubre cómo hacer algo (porque Claude se lo
// arregló tras una escalación, porque ella misma resolvió un caso
// difícil, o porque un admin se lo enseñó manualmente), se persiste
// como AiAgentLesson. En cada run posterior, el runner carga las
// lecciones relevantes al contexto y las inyecta en el initial
// message. Así Sonia "aprende" entre runs sin necesidad de
// reentrenar el modelo.
// ====================================================================

model AiAgentLesson {
  id          String  @id @default(cuid())
  workspaceId String
  // Scope semántico — usado para filtrar qué lecciones cargar en
  // cada run. Convención:
  //   "general"                    → siempre cargar
  //   "tool:meta_ads_*"            → si la task mencione meta ads
  //   "client:<clientId>"          → si el task tiene ese client
  //   "task_type:meta_lead_campaign" → si trigger context coincide
  //   "error_pattern:robots_txt"   → match por palabra clave error
  scope       String
  // Texto natural que se inyecta en el system prompt cuando aplica.
  // Pensado como instrucción accionable, ej:
  //   "Cuando el user pegue múltiples tokens Meta en comentarios,
  //    usa el ÚLTIMO (más reciente), no el primero."
  lesson      String  @db.Text
  // Patrón regex/keyword para refinar el matching dentro del scope.
  // Opcional: si null, se carga siempre que el scope aplique.
  triggerPattern String? @db.Text
  // Quién creó la lección. Solo para auditoría:
  //   "claude"     → Claude Code tras resolver una escalación
  //   "sonia_self" → Sonia llamó record_lesson durante un run
  //   "human"      → un admin del workspace
  source      String  @default("sonia_self")
  // Task donde se aprendió (opcional, para auditoría).
  taskId      String?
  // Cuántas veces se ha cargado/aplicado esta lección. Las más
  // usadas se priorizan cuando hay muchas y hay que recortar.
  useCount    Int     @default(0)
  lastUsedAt  DateTime?
  // Lecciones obsoletas pueden inactivarse sin borrar (para auditoría).
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, isActive])
  @@index([workspaceId, useCount])
}

// ====================================================================
// PLANTILLAS DE TAREAS
// ====================================================================
//
// El usuario crea plantillas con nombre + descripción + campos
// preconfigurados (proyecto default, prioridad, assignees, tags, due
// offset en días) + campos personalizados (custom fields) tipo
// text/textarea/number/date/select/multiselect/checkbox.
//
// Al crear una task desde una plantilla:
//   - Los campos estándar se prerellenan en el TaskFormModal.
//   - Los custom fields se renderizan dinámicamente y al guardar
//     los valores van a Task.customData (JSON keyed por field id).
//
// customFields shape (Json):
//   [
//     {
//       id: "cliente_destino",
//       label: "Cliente destino",
//       type: "select",
//       required: true,
//       options: ["Reva", "Champiso", "Esaem"],
//       placeholder: "Elige cliente"
//     },
//     ...
//   ]
//
// types soportados:
//   text | textarea | number | date | select | multiselect | checkbox
//
// Al editar la task más tarde, el modal recupera customData del Task
// y los pinta otra vez con el schema del TaskTemplate referenciado.
model TaskTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  // Emoji o nombre de icono lucide para mostrar en el selector.
  icon        String?

  // Pre-fills (todos opcionales). Si null, el formulario coge el
  // default que tendría una task nueva sin plantilla.
  defaultProjectId      String?
  defaultStatus         String? // id de columna kanban
  defaultPriority       String? // LOW / MEDIUM / HIGH / URGENT
  defaultAssigneeIds    Json? // string[] de userIds
  defaultTags           Json? // string[] de tag names
  // Offset desde la creación de la task. Si 3, dueDate = now + 3d.
  defaultDueOffsetDays  Int?
  // Cuerpo de descripción preconfigurado (markdown / texto plano).
  // El TaskFormModal lo carga al rich text editor.
  bodyMarkdown          String? @db.Text

  // Schema de custom fields (ver doc arriba).
  customFields Json?

  // Workflow IA preconfigurado para Sonia. Si presente y la task se
  // procesa con AI agent, este workflow se inyecta al SYSTEM_PROMPT
  // como "secuencia EXACTA a seguir" — Sonia no decide los pasos,
  // los ejecuta linealmente. Estructura:
  // {
  //   description: "Resumen del workflow para Sonia",
  //   steps: [
  //     { tool: "validate_credentials", input: {...}, why: "..." },
  //     { tool: "meta_ads_list_campaigns", input: {...}, why: "..." },
  //     ...
  //   ],
  //   successCriteria: "Qué debe verificar al final"
  // }
  // Si null, Sonia improvisa como hoy.
  aiWorkflow   Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

// ============================================================================
// GMB HUB — gestión de fichas de Google My Business (port del plugin WP).
// La conexión con Google se hace VÍA MAKE.COM (igual que el plugin original):
// Make trae las reseñas por webhook y publica las respuestas por webhook.
// Maps Places + ScraperAPI + OpenAI sí se llaman directo (fases 2/3).
// ============================================================================

model GmbClient {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  category    String   @default("")
  description String?  @db.Text
  tone        String   @default("profesional") // profesional|cercano|formal|entusiasta|custom
  customTone  String?  @db.Text
  accountId   String   @default("") // GMB "accounts/XXX"
  locationId  String   @default("") // GMB "accounts/XXX/locations/YYY"
  emails      String   @default("") // emails de notificación, separados por coma
  mainKeyword String   @default("")
  autoReply   String   @default("manual") // manual|auto
  connectionId String  @default("") // override de connection de Make
  frequency   Int      @default(15) // minutos
  scenarioId  String   @default("") // id del escenario de Make
  status      String   @default("active") // active|paused
  // Campos geo/SEO (el plugin los usa pero no estaban en el CREATE original)
  placeId     String   @default("")
  latitude    Float?
  longitude   Float?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  phone       String   @default("")
  website     String   @default("")
  address     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews    GmbReview[]
  activities GmbActivity[]
  clientTags GmbClientTag[]
  ratingHistory GmbRatingHistory[]

  @@index([workspaceId])
  @@index([workspaceId, status])
}

model GmbReview {
  id          String    @id @default(cuid())
  workspaceId String
  clientId    String
  reviewId    String // id de Google (o generado rev_+hash)
  authorName  String   @default("")
  authorPhoto String   @default("")
  rating      Int      @default(0) // 1-5
  comment     String?  @db.Text
  reviewReply String?  @db.Text
  reviewTime  DateTime?
  updateTime  DateTime?
  createdAt   DateTime @default(now())

  client GmbClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, reviewId])
  @@index([workspaceId])
  @@index([clientId])
}

model GmbActivity {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  actionType  String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  client GmbClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
}

model GmbTag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#F4600C")
  createdAt   DateTime @default(now())

  clientTags GmbClientTag[]

  @@index([workspaceId])
}

model GmbClientTag {
  id       String @id @default(cuid())
  clientId String
  tagId    String

  client GmbClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    GmbTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([clientId, tagId])
  @@index([clientId])
  @@index([tagId])
}

model GmbRatingHistory {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  monthYear   String // YYYY-MM
  avgRating   Float    @default(0)
  reviewCount Int      @default(0)
  recordedAt  DateTime @default(now())

  client GmbClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, monthYear])
  @@index([workspaceId])
}

model GmbKeyword {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  keyword     String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([clientId, keyword])
  @@index([workspaceId])
  @@index([clientId])
}

model GmbPosition {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  keyword     String
  avgPosition Float    @default(0) // media de posición en las celdas encontradas (0 = no aparece)
  top3Count   Int      @default(0)
  foundCount  Int      @default(0)
  cellCount   Int      @default(0)
  gridData    Json? // matriz de celdas [{lat,lng,position}]
  checkedAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([clientId, keyword])
}

// Llamadas de voz de Sonia (agente conversacional vía Vapi). El número +
// asistente se configuran en Vapi; aquí guardamos cada llamada y su
// resultado (transcripción, resumen, datos extraídos) que llega por webhook.
model VoiceCall {
  id           String   @id @default(cuid())
  workspaceId  String
  provider     String   @default("vapi")
  providerCallId String? // id de la llamada en Vapi
  toNumber     String
  goal         String?  @db.Text // objetivo/guion de la llamada
  status       String   @default("queued") // queued|ringing|in-progress|ended|failed
  endedReason  String?
  durationSec  Int?
  transcript   String?  @db.Text
  summary      String?  @db.Text
  structured   Json? // datos extraídos (variables/análisis)
  recordingUrl String?
  clientId     String?
  createdById  String?
  taskId       String? // tarea creada en "Reuniones y llamadas" al colgar
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId])
  @@index([providerCallId])
}

// === GMB Hub — Bloque Contenido + IA ===

// Fotos de la ficha (galería por cliente)
model GmbPhoto {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  url         String   @db.Text
  type        String   @default("general") // general|logo|cover|interior|exterior|producto
  caption     String   @default("")
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([clientId])
}

// Preguntas y respuestas de la ficha
model GmbQa {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  question    String   @db.Text
  answer      String   @db.Text
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([clientId])
}

// Plantillas de respuesta a reseñas
model GmbReplyTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?  // null = plantilla global del workspace
  name        String
  content     String   @db.Text
  type        String   @default("positive") // positive|neutral|negative
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([clientId])
}

// Publicaciones de Google Business Profile (programadas / borradores)
model GmbPost {
  id           String    @id @default(cuid())
  workspaceId  String
  clientId     String
  title        String    @default("")
  content      String    @db.Text
  cta          String    @default("")
  imageUrl     String?   @db.Text
  scheduledAt  DateTime?
  status       String    @default("draft") // draft|scheduled|published|failed
  publishedAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
  @@index([clientId])
  @@index([status])
}

// === GMB Hub — Bloque Alertas y notificaciones ===

// Notificaciones in-app del GMB Hub (reseñas negativas, cambios de posición,
// cambios en la ficha…). Se marcan como leídas y alimentan el contador.
model GmbNotification {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String?
  type        String   // negative_review|position_drop|profile_change|claimable|info
  title       String
  body        String?  @db.Text
  data        Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([workspaceId, isRead])
  @@index([clientId])
}

// Snapshots de la ficha para detectar cambios (rating, nº reseñas, teléfono…).
model GmbSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  clientId    String
  data        Json
  changes     Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([clientId])
}

// === GMB Hub — Bloque Buscador/captación avanzado ===

// Búsquedas guardadas del buscador GMB (captación de fichas reclamables).
model GmbSearch {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  locations      String   @db.Text // una localización por línea
  keyword        String   @default("")
  type           String   @default("")
  radiusKm       Float    @default(3)
  schedule       String   @default("none") // none|daily|weekly|monthly
  lastRun        DateTime?
  totalFound     Int      @default(0)
  totalClaimable Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  results GmbSearchResult[]

  @@index([workspaceId])
  @@index([schedule])
}

model GmbSearchResult {
  id          String   @id @default(cuid())
  workspaceId String
  searchId    String
  placeId     String
  name        String   @default("")
  address     String   @default("")
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  lat         Float    @default(0)
  lng         Float    @default(0)
  isClaimable Boolean  @default(false)
  checked     Boolean  @default(false)
  checkedAt   DateTime?
  createdAt   DateTime @default(now())

  search GmbSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@unique([searchId, placeId])
  @@index([workspaceId])
  @@index([searchId])
}

// Base de conocimiento de Sonia: textos de aprendizaje + documentos de
// clientes que el admin sube. Se indexan para búsqueda semántica y el chat
// los consulta para responder preguntas directas sobre lo que se gestiona.
model SoniaKnowledge {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  content     String   @db.Text
  sourceType  String   @default("text") // text | document
  fileName    String?
  fileId      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

// ════════════════════════════════════════════════════════════════════
// BIPI — App de descuentos cruzados entre negocios locales
// ════════════════════════════════════════════════════════════════════
// Producto independiente que vive en el mismo Hub (mismo Postgres) con
// tablas separadas. Cada negocio Bipi tiene su QR único; cada cliente
// que lo escanea entra a la red y desbloquea descuentos en negocios
// complementarios cercanos con caducidad de 4 días.

/// Negocio dado de alta en la red Bubui.
model BubuiBusiness {
  @@map("BipiBusiness")
  id            String   @id @default(cuid())
  // Slug humano para QR url corto y SEO (bubui.app/n/spa-bambu).
  slug          String   @unique
  name          String
  category      String   // peluquería | restaurante | gimnasio | spa | nutrición | ...
  // Tipo de negocio → decide qué secciones ve en su panel (la Mesa Colectiva
  // solo para restaurante; catálogo/stock para comercio_producto; etc.).
  businessType  String   @default("servicios") // restaurante | comercio_producto | servicios
  // Reservas/citas (nicho servicios): si está activo, los clientes piden cita
  // desde la ficha pública y el comercio las confirma desde su panel.
  bookingEnabled Boolean  @default(false)
  description   String?  @db.Text
  // Localización del local (para geofencing + radio de visibilidad).
  address       String?
  city          String   @default("Benalmádena")
  province      String   @default("Málaga")
  latitude      Float?
  longitude     Float?
  // Teléfono PÚBLICO de contacto del negocio (botón "Llamar" en la app).
  // Distinto de ownerPhone (privado, del titular de la cuenta).
  phone         String?
  // Branding mínimo.
  logoUrl       String?
  brandColor    String?
  // Oferta default (descuento estándar al cliente cuando escanea).
  defaultDiscountPct Int @default(5)
  // Cupón cruzado: el % que ofrece a clientes de otros negocios.
  crossDiscountPct   Int @default(8)
  // % de descuento extra que el negocio regala al cliente cuando deja una
  // reseña. 0 = no se incentivan reseñas. Solo se da una vez por cliente
  // (clave única en BubuiOffer triggerBusinessId="review:<businessId>").
  reviewRewardPct    Int @default(0)
  // Place ID de Google Business Profile (Google My Business) del negocio,
  // si lo tienen verificado. Habilita el CTA "compártela también en Google"
  // tras dejar una reseña — abre el formulario de reseñas de Google con
  // este local pre-seleccionado.
  googlePlaceId      String?
  // Redes y reseñas del negocio (autocompletadas por IA al darse de alta y
  // verificadas por el dueño). Para enlazarlas en su ficha y para reseñas.
  instagramUrl       String?
  facebookUrl        String?
  tiktokUrl          String?
  trustpilotUrl      String?
  tripadvisorUrl     String?
  // ── Crecimiento viral + reseñas ──────────────────────────────────
  // Oferta-reto: tras escanear el ticket, al cliente se le crea una oferta
  // MAYOR (shareOfferPct), bloqueada, que solo se activa cuando comparte
  // Bubui y consigue `shareOfferFriends` amigos nuevos verificados. 0 = off.
  shareOfferPct      Int     @default(0)
  shareOfferFriends  Int     @default(5)
  shareOfferLabel    String? // etiqueta no-% opcional (ej. "Postre gratis")
  // Solicitud de reseña en Google: push automático ~10 min tras escanear,
  // llevando al cliente a dejar reseña en Google (requiere googlePlaceId).
  reviewPushEnabled  Boolean @default(true)
  // Preferencias de PUSH al panel del dueño: de qué eventos quiere que le
  // avisemos en su dispositivo (el feed "Novedades" del panel siempre los
  // registra; estos flags solo controlan la notificación push).
  pushOnNewClient Boolean @default(true) // cliente referido nuevo
  pushOnReview    Boolean @default(true) // reseña nueva
  pushOnBooking   Boolean @default(true) // cita/reserva nueva
  pushOnCoupon    Boolean @default(true) // cupón Bubui canjeado
  // Tarjeta de fidelidad (sellos digitales). Cada compra confirmada del
  // cliente suma 1 sello; al completar `loyaltyGoal` sellos se desbloquea
  // automáticamente un cupón con loyaltyRewardPct (o loyaltyRewardLabel) y
  // la tarjeta arranca el siguiente ciclo. Triggers únicos
  // "loyalty:<businessId>:<cycle>" → un cliente puede ciclar muchas veces
  // pero no farmea dentro de un ciclo.
  loyaltyEnabled     Boolean @default(false)
  loyaltyGoal        Int     @default(5) // nº de visitas para completar
  loyaltyRewardPct   Int     @default(0) // % de la recompensa (0 = label)
  loyaltyRewardLabel String? // texto libre alternativo (ej. "Café gratis")
  // Premium: cupón automático el día del cumpleaños del cliente.
  birthdayEnabled    Boolean @default(false)
  birthdayDiscountPct Int    @default(15)
  birthdayMessage    String? @db.Text
  // Premium: ruleta / rasca y gana al escanear el QR. En lugar del descuento
  // fijo (defaultDiscountPct) se sortea uno aleatorio entre min y max.
  wheelEnabled       Boolean @default(false)
  wheelMinPct        Int     @default(3)
  wheelMaxPct        Int     @default(20)
  // ── MESA COLECTIVA (restauración): descuento de grupo viral ──────────
  // El anfitrión escanea el QR del local y la app le muestra un QR de mesa;
  // el resto de comensales lo escanean para unirse (ventana mesaJoinWindowMin).
  // El descuento base se aplica si hay >= mesaMinDiners. Sube si TODOS comparten
  // (mesaShareBonusPct, cada uno con mesaShareFriends amigos nuevos) y si TODOS
  // dejan reseña en Google (mesaReviewBonusPct, vía enlace, sin condicionar a
  // que sea positiva). El bonus se entrega como cupón de PRÓXIMA visita con
  // mesaNextVisitDays de caducidad (recurrencia). Todo configurable aquí.
  mesaEnabled        Boolean @default(true)
  mesaBasePct        Int     @default(5)
  mesaMinDiners      Int     @default(4)
  mesaShareBonusPct  Int     @default(5)
  mesaShareFriends   Int     @default(3)
  mesaReviewBonusPct Int     @default(3)
  // Plataforma de reseña que da el bonus de la Mesa (según el nicho).
  mesaReviewPlatform String  @default("google") // google | tripadvisor | trustpilot | instagram
  mesaMaxPct         Int     @default(20) // tope de seguridad
  mesaJoinWindowMin  Int     @default(60) // minutos para unirse a la mesa
  mesaNextVisitDays  Int     @default(15) // caducidad del cupón próxima visita
  // true = los bonus (compartir/reseña) se aplican a la cuenta de ESTA visita;
  // false (def) = se guardan como cupón de próxima visita (recurrencia).
  mesaBonusOnThisVisit Boolean @default(false)
  // Valor neto-nuevo: el comensal NUEVO aporta instalándose; el VETERANO (ya
  // tenía la app) debe completar una acción del menú para que su parte cuente.
  // Evita regalar descuento sin recibir nada cuando la zona ya está saturada.
  mesaVeteranMustContribute Boolean @default(true)
  // Primera descarga: false (def) = el comensal NUEVO desbloquea su parte solo
  // con instalarse/darse de alta; true = aunque sea nuevo, debe completar también
  // una acción del menú (compartir/reseña) para que su parte cuente.
  mesaNewUserMustContribute Boolean @default(false)
  mesaVeteranShareFriends   Int     @default(1) // amigos si elige "compartir"
  mesaAutoAdjust            Boolean @default(true) // sube exigencia con la saturación
  // Menú de acciones que el comercio acepta como aporte del veterano.
  mesaActShare  Boolean @default(true)  // invitar amigos
  mesaActReview Boolean @default(true)  // reseña en Google
  mesaActPhoto  Boolean @default(true)  // foto del plato (UGC)
  mesaActFollow Boolean @default(false) // seguir en redes
  // Regalo de PRÓXIMA visita (alternativa/extra al % por completar los pasos):
  // texto libre, ej. "1 bebida gratis", "1 café gratis". Si está, al completar
  // los pasos extra (compartir/reseña) cada comensal recibe un cupón canjeable
  // la próxima vez. Vacío = solo % de descuento.
  mesaPerkLabel String?
  // Programa de afiliados: recompensas por hitos de amigos traídos.
  referralEnabled Boolean @default(true)
  referralReward1 String? // recompensa al traer 1 amigo
  referralReward3 String? // al traer 3
  referralReward5 String? // al traer 5
  // Programa de referidos B2B: cuántas semanas de banner Home se le han
  // otorgado por traer negocios (1 semana por cada 5 negocios activos).
  // bannerWeeksGranted es acumulativo histórico; se compara con floor(refs/5)
  // para saber cuántas semanas nuevas hay que conceder.
  bannerWeeksGranted Int @default(0)
  // Cartel/QR físico: el negocio puede imprimirlo él mismo o pedir que se
  // lo llevemos gratis (facilita el alta y acelera el crecimiento). Si
  // posterDeliveryRequestedAt != null y posterDeliveredAt == null, está
  // pendiente de que el equipo le lleve el cartel a la dirección indicada.
  posterDeliveryRequestedAt DateTime?
  posterDeliveryAddress     String?
  posterDeliveryPhone       String?
  posterDeliveryNote        String?   @db.Text
  posterDeliveredAt         DateTime?
  // Karma de visibilidad (0-100, recalculado nocturno).
  visibilityScore Int @default(50)
  scoreUpdatedAt  DateTime?
  // Modelo de validación de compra.
  purchaseMode  String   @default("express") // express | double_confirm
  // Anti-fraude: si está activo, el cliente DEBE fotografiar el ticket y el
  // importe lo lee la IA (no se teclea libremente). El importe se toma del
  // servidor (BubuiTicketScan), no del cliente.
  requireTicket Boolean  @default(false)
  // Suscripción.
  plan          String   @default("free") // free | pro | premium
  // Email + contraseña hash del dueño (auth simple v1; iremos a oauth en v2).
  ownerEmail    String   @unique
  ownerPasswordHash String
  ownerName     String?
  ownerPhone    String?
  // Quien lo refirió a Bubui (si vino vía QR de otro negocio).
  referrerId    String?
  // Stripe billing — para suscripción Pro/Premium.
  bubuiStripeCustomerId  String? @map("bipiStripeCustomerId")
  bubuiStripeSubscriptionId String? @map("bipiStripeSubscriptionId")
  planExpiresAt DateTime? // null o futuro = activo; pasado = volver a free.
  // Cancelación programada: si está, la suscripción se cancela al final del
  // periodo ya pagado (cancel_at_period_end en Stripe). Hasta esa fecha el
  // negocio conserva las ventajas del plan.
  subscriptionCancelAt DateTime?
  // Recuperación de contraseña: hash del token de un solo uso + caducidad.
  ownerResetTokenHash String?
  ownerResetExpiresAt DateTime?
  // Secreto de sesión del panel: se compara con el `<id>:<secret>` que envía
  // el panel. Se emite/renueva en el login. null hasta el próximo login.
  apiToken      String?
  // Status.
  active        Boolean  @default(true)
  // Destacado en Descubre (ordenación preferente).
  featured      Boolean  @default(false)
  // Destacado TEMPORAL: premio del ranking mensual (negocio que más clientes
  // trajo). Mientras featuredUntil > now, cuenta como destacado en Descubre.
  featuredUntil DateTime?
  // Banner IA (foto del escaparate → banner con el nombre del negocio).
  // La PRIMERA generación es gratis; cada edición extra cuesta 1€ y concede
  // 1 crédito (aiBannerCredits) al confirmar el pago en Stripe.
  aiBannerUsed    Int @default(0)
  aiBannerCredits Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  referrer       BubuiBusiness?              @relation("BubuiReferral", fields: [referrerId], references: [id])
  referrals      BubuiBusiness[]             @relation("BubuiReferral")
  purchases      BubuiPurchase[]
  offers         BubuiOffer[]
  pushAds        BubuiPushAd[]
  notifications  BubuiBusinessNotification[]
  reviews        BubuiReview[]
  sponsoredSlots BubuiSponsoredSlot[]
  bannerCampaigns BubuiBannerCampaign[]
  tableSessions  BubuiTableSession[]
  products       BubuiProduct[]
  services       BubuiService[]
  bookings       BubuiBooking[]

  @@index([city, active])
  @@index([referrerId])
  @@index([visibilityScore])
}

/// Cliente final dado de alta en la app Bubui.
model BubuiCustomer {
  @@map("BipiCustomer")
  id              String   @id @default(cuid())
  email           String   @unique
  phone           String?  @unique
  phoneVerified   Boolean  @default(false)
  name            String?
  gender          String?  // male | female | other
  birthDate       String?  // YYYY-MM-DD
  postalCode      String?  // CP de residencia (5 dígitos) — ofertas cerca de casa
  // Token push (Expo / FCM / APNs).
  pushToken       String?
  // Token de sesión opaco para autenticar las llamadas de la app a los
  // endpoints /customer/[id]/*, /offers y /scan. Se emite/renueva al verificar
  // el OTP y al hacer login. null en cuentas antiguas hasta el próximo login.
  apiToken        String?
  // Versión de la app instalada (la reporta la app móvil en cada apertura del
  // feed). appBuild = versionCode (Android) / buildNumber (iOS), p. ej. "1015".
  // Sirve para saber qué build tiene cada usuario al hacer pruebas.
  appVersion      String?  // p. ej. "1.0.0"
  appBuild        String?  // p. ej. "1015"
  appPlatform     String?  // ios | android
  lastSeenAt      DateTime? // última vez que la app llamó al backend
  // Última ubicación (para feed + push geo).
  lastLat         Float?
  lastLng         Float?
  lastLocationAt  DateTime?
  // Métrica showcase.
  totalSaved      Float    @default(0) // €  total ahorrados con Bubui
  totalPurchases  Int      @default(0)
  // Embajador (nivel desbloqueado).
  ambassadorLevel String   @default("none") // none | bronze | silver | gold | founder
  // Suscripción "Bubui Plus" del usuario (1€/mes, cobro por Stripe en web).
  // plan: free | plus. planExpiresAt null o futuro = activo; pasado = free.
  plan          String   @default("free")
  planExpiresAt DateTime?
  subscriptionCancelAt DateTime? // fin de periodo si canceló (sigue Plus hasta entonces)
  bubuiStripeCustomerId     String?
  bubuiStripeSubscriptionId String?
  // Quien lo refirió (negocio donde escaneó por primera vez).
  firstBusinessId String?
  // Programa de afiliados.
  referralCode    String?  @unique // código corto para su enlace de invitación
  referredById    String?  // cliente que lo invitó
  // Hucha de referidos: % acumulado que el cliente cobra yendo a comer (solo).
  // Se abona cuando un amigo traído se CUALIFICA (alta + tel. verificado + 1ª
  // compra confirmada). Al canjear se aplica hasta el tope por visita del
  // negocio (mesaMaxPct); el sobrante se queda acumulado. Caducidad global
  // (referralWalletExpiresAt), se renueva con cada abono.
  referralWalletPct       Int       @default(0)
  referralWalletExpiresAt DateTime?
  referralQualifiedCount  Int       @default(0) // amigos cualificados (histórico)
  // true cuando ESTE cliente ya ha cualificado a su referidor (idempotencia del
  // abono: un amigo abona como máximo una vez a quien lo trajo).
  referralQualified       Boolean   @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchases BubuiPurchase[]
  offers    BubuiOffer[]
  pushLogs  BubuiPushLog[]
  reviews   BubuiReview[]

  @@index([lastLat, lastLng])
}

/// Compra registrada con escaneo del QR.
///
/// Estados:
///   pending   → cliente escaneó e introdujo importe; negocio aún no confirma.
///   confirmed → negocio aprobó. Descuento aplicado, ofertas desbloqueadas.
///   rejected  → negocio rechazó (importe incorrecto o no es válido).
model BubuiPurchase {
  @@map("BipiPurchase")
  id              String   @id @default(cuid())
  customerId      String
  businessId      String
  amount          Float    // importe bruto pagado en caja
  discountPct     Int      // descuento aplicado %
  discountAmount  Float    // € de descuento
  status          String   @default("pending") // pending | confirmed | rejected
  // Si vino vía un cupón cruzado, link al BubuiOffer que se canjeó.
  redeemedOfferId String?
  // Geolocalización al escanear (anti-fraude).
  scanLat         Float?
  scanLng         Float?
  scanDistanceM   Float?   // distancia al local en metros
  // Razón si rejected.
  rejectionReason String?
  // Foto del ticket de compra (si el cliente la subió para leer el importe con IA).
  ticketUrl       String?
  scannedAt       DateTime @default(now())
  confirmedAt     DateTime?
  // Cuándo se envió el push de "déjanos una reseña en Google" (~10 min tras
  // escanear). null = pendiente de enviar; lo procesa el cron review-requests.
  reviewPushedAt  DateTime?

  customer BubuiCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@index([customerId])
  @@index([scannedAt])
  @@index([status, reviewPushedAt])
}

/// Oferta desbloqueada para un cliente concreto en un negocio concreto.
/// Se generan tras cada compra confirmada (3-5 ofertas de negocios
/// complementarios cercanos) y caducan a los 4 días.
model BubuiOffer {
  @@map("BipiOffer")
  id              String   @id @default(cuid())
  customerId      String
  businessId      String   // negocio que ofrece el descuento
  discountPct     Int
  // Negocio "originador" — la compra que desbloqueó esta oferta.
  // En ofertas de afiliados se usa como marcador: "ref:1" | "ref:3" |
  // "ref:5" | "ref:welcome" (garantiza unicidad por hito).
  triggerBusinessId String?
  // Etiqueta de premio no porcentual (ej. "Tapa gratis"). Si está, la UI
  // la muestra en vez del %.
  rewardLabel     String?
  // Origen de la oferta: "cross" (cupón cruzado) | "referral" | "referral_welcome"
  //  | "review_reward" | "share_challenge" (oferta-reto viral) | "mesa" (cupón
  //  próxima visita de la Mesa Colectiva) | "mesa_followup" (acción no elegida).
  source          String?  @default("cross")
  // Oferta-reto viral: si active=false la oferta está BLOQUEADA y no se puede
  // canjear hasta conseguir `unlockShares` amigos verificados nuevos por
  // encima de `unlockBaseline` (los que el cliente ya tenía al crearse).
  active          Boolean  @default(true)
  unlockShares    Int      @default(0)
  unlockBaseline  Int      @default(0)
  // Activación ALTERNATIVA de una oferta-reto (reseña/foto validada por IA), en
  // vez de por amigos. Solo disponible para usuarios con +10 amigos dados de alta.
  activatedByAction    Boolean @default(false)
  activatedProvisional Boolean @default(false) // la IA no validó: revisar a mano
  activationShotUrl    String? // captura usada para activar por acción
  expiresAt       DateTime
  redeemed        Boolean  @default(false)
  redeemedAt      DateTime?
  createdAt       DateTime @default(now())

  customer BubuiCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([customerId, expiresAt])
  @@index([businessId, expiresAt])
  @@unique([customerId, businessId, triggerBusinessId])
}

/// Anuncio push pagado (el "Push del Día" que paga el negocio por 24h).
model BubuiPushAd {
  @@map("BipiPushAd")
  id            String   @id @default(cuid())
  businessId    String
  title         String
  body          String   @db.Text
  // Imagen grande opcional (rich push) — capta más la atención.
  imageUrl      String?  @db.Text
  // Radio de envío (km).
  radiusKm      Float    @default(1)
  centerLat     Float
  centerLng     Float
  // Pricing.
  reach         Int      // usuarios estimados al crear
  pricePaidEur  Float
  // Programación.
  startsAt      DateTime
  endsAt        DateTime
  // Stats.
  sentCount     Int      @default(0)
  openedCount   Int      @default(0)
  redeemCount   Int      @default(0)
  status        String   @default("scheduled") // scheduled | sending | done | cancelled
  createdAt     DateTime @default(now())

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([startsAt, endsAt])
}

/// Log de cada push enviado (para evitar dups y medir performance).
model BubuiPushLog {
  @@map("BipiPushLog")
  id          String   @id @default(cuid())
  customerId  String
  pushAdId    String?
  kind        String   // ad | offer_expiring | new_offers | welcome
  payload     Json
  sentAt      DateTime @default(now())
  opened      Boolean  @default(false)

  customer BubuiCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, sentAt])
}

/// Suscripción Web Push de un cliente Bubui (PWA). Permite mandarle
/// notificaciones de "tu cupón caduca en 4h" y "nuevo descuento cerca".
/// Cuando el cliente desinstala la PWA o desactiva permisos, web-push
/// devuelve 404/410 y la limpiamos automáticamente.
model BubuiPushSubscription {
  @@map("BipiPushSubscription")
  id          String   @id @default(cuid())
  customerId  String
  endpoint    String   @unique
  p256dh      String
  authKey     String
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([customerId])
}

/// Suscripción Web Push del PANEL del negocio (PWA). Igual que
/// BubuiPushSubscription pero keyed por businessId: avisa al dueño en su
/// dispositivo (ej. "Bubui te ha traído un cliente nuevo").
model BubuiBusinessPushSubscription {
  @@map("BipiBusinessPushSubscription")
  id          String   @id @default(cuid())
  businessId  String
  endpoint    String   @unique
  p256dh      String
  authKey     String
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([businessId])
}

/// Token de push para apps móviles nativas (Expo Push Service). El campo
/// `token` empieza por `ExponentPushToken[...]` o `ExpoPushToken[...]`.
/// La entrega final en Android necesita FCM configurado en EAS.
model BubuiMobilePushToken {
  @@map("BipiMobilePushToken")
  id          String   @id @default(cuid())
  customerId  String
  token       String   @unique
  platform    String   // "ios" | "android"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([customerId])
}

/// Ajustes simples clave-valor de Bubui (p. ej. banner del Home).
model BubuiSetting {
  @@map("BipiSetting")
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt
}

/// Regalo exclusivo para suscriptores "Bubui Plus". Lo gestiona el admin y
/// solo lo ven (en la app) los usuarios con plan plus activo.
model BubuiPlusGift {
  @@map("BipiPlusGift")
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String?
  link        String?  // opcional: a dónde lleva al tocar (canje, web…)
  order       Int      @default(0) // orden de aparición (asc)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

/// Idempotencia de webhooks de Stripe: el id del evento se guarda al
/// procesarlo. Si Stripe reintenta la entrega del mismo evento, se ignora
/// (evita, p. ej., conceder dos créditos de Banner IA por un solo pago).
model BubuiProcessedWebhook {
  @@map("BipiProcessedWebhook")
  id          String   @id // event.id de Stripe
  processedAt DateTime @default(now())
}

/// Latido de los crons: cada vez que un endpoint de cron se ejecuta con auth
/// válida registra aquí su `lastRunAt`. El watchdog (health-watchdog) compara
/// con la cadencia esperada (catálogo en lib/cron-monitor) y avisa si un cron
/// lleva "mudo" más de lo previsto — así un fallo silencioso (como el del
/// CRON_SECRET desparejado) salta en horas, no en semanas. `alertedAt` evita
/// repetir el aviso del mismo incidente.
model CronHeartbeat {
  name      String   @id // p.ej. "ai-agent/recurring"
  lastRunAt DateTime @default(now())
  runs      Int      @default(0)
  alertedAt DateTime?
}

/// Anti-fraude por ticket: cuando el cliente fotografía el ticket, la IA lee
/// el importe y se guarda aquí ligado a la imagen. El escaneo (scan) usa ESTE
/// importe (no el que teclee el cliente) y marca el registro como usado
/// (un ticket = una compra). Caduca a los 30 min si no se usa.
model BubuiTicketScan {
  @@map("BipiTicketScan")
  id               String   @id @default(cuid())
  customerId       String
  businessId       String?
  amount           Float? // null si la IA no pudo leerlo
  currency         String   @default("EUR")
  confidence       Float    @default(0)
  ticketUrl        String   @db.Text
  usedByPurchaseId String? // null hasta consumirse en un scan
  createdAt        DateTime @default(now())

  @@index([customerId])
}

/// Imagen subida y servida desde la propia BD (sin bucket externo). Se usa
/// como fallback del banner cuando no hay storage S3/R2 configurado: la
/// imagen se guarda aquí y se sirve vía /api/bubui/banner-image/<id>.
model BubuiImage {
  @@map("BipiImage")
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

/// Notificación para el panel del negocio (nueva compra, cupón canjeado…).
model BubuiBusinessNotification {
  @@map("BipiBusinessNotification")
  id         String   @id @default(cuid())
  businessId String
  type       String   // new_purchase | offer_redeemed | referral_milestone | ...
  message    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, read])
  @@index([createdAt])
}

/// Reseña/valoración de un cliente a un negocio. Solo puede dejarla quien
/// tiene al menos una compra confirmada en ese negocio (se valida en el
/// endpoint). Una reseña por cliente y negocio; se puede editar reenviando.
model BubuiReview {
  @@map("BipiReview")
  id         String   @id @default(cuid())
  businessId String
  customerId String
  rating     Int      // 1-5 estrellas
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer BubuiCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, businessId])
  @@index([businessId, createdAt])
}

/// Mesa Colectiva: una mesa de un restaurante que activa un descuento de grupo
/// viral. El anfitrión la crea y su app muestra un QR de mesa; los demás
/// comensales lo escanean para unirse (ventana de unión). El % sube si todos
/// comparten Bubui y/o dejan reseña en Google. El dueño la verifica desde su
/// panel y la canjea. status: open → verified → redeemed | expired.
model BubuiTableSession {
  @@map("BipiTableSession")
  id           String    @id @default(cuid())
  businessId   String
  code         String    // código corto de unión (único entre sesiones abiertas)
  tableLabel   String?   // nº/nombre de mesa
  captainId    String?   // BubuiCustomer que la creó
  status       String    @default("open") // open | verified | redeemed | expired
  basePct      Int       @default(0) // snapshot de config al crear
  shareBonusPct Int      @default(0)
  reviewBonusPct Int     @default(0)
  maxPct       Int       @default(35)
  minDiners    Int       @default(4)
  shareFriends Int       @default(3)
  finalPct     Int?      // % aplicado al canjear
  ticketAmount Float?    // total del ticket escaneado (importe de la cuenta)
  billedById   String?   // BubuiCustomer que escaneó el ticket (quien pagó)
  expiresAt    DateTime  // fin de la ventana de unión
  verifiedAt   DateTime?
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     BubuiBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  participants BubuiTableParticipant[]

  @@index([businessId, status])
  @@index([code, status])
}

model BubuiTableParticipant {
  @@map("BipiTableParticipant")
  id          String   @id @default(cuid())
  sessionId   String
  customerId  String
  isNewUser   Boolean  @default(false) // se instaló la app al unirse a esta mesa
  contributed Boolean  @default(false) // veterano que completó una acción del menú
  contributionType String? // share | review | photo | follow
  sharedCount Int      @default(0)
  sharedDone  Boolean  @default(false) // alcanzó shareFriends amigos nuevos
  reviewDone  Boolean  @default(false) // pasó por el enlace de reseña de Google
  // Acciones VERIFICADAS por IA (captura subida): cuentan para el bote de la mesa.
  // Cada comensal puede aportar hasta 2 (una reseña + una publicación social) para
  // cubrir a quien no puede/quiere; la mesa necesita N acciones (N = comensales).
  reviewVerified Boolean @default(false) // captura de reseña validada por IA
  socialVerified Boolean @default(false) // captura de FOTO en redes validada (acción "photo")
  reviewShotUrl  String? // URL de la captura de la reseña
  socialShotUrl  String? // URL de la captura de la publicación (foto)
  // Acción "seguir en redes" (independiente de la foto).
  followVerified Boolean @default(false)
  followShotUrl  String?
  // Aceptada de forma PROVISIONAL (la IA no pudo validar con seguridad): cuenta
  // para el bote pero se marca para que el CAMARERO la verifique a mano.
  reviewProvisional Boolean @default(false)
  socialProvisional Boolean @default(false)
  followProvisional Boolean @default(false)
  // Momento del primer aporte (para el push diferido ~1h de la acción no elegida).
  contributedAt  DateTime?
  // Marca de que ya se envió el push de la "acción no elegida" (idempotencia).
  followupPushedAt DateTime?
  joinedAt    DateTime @default(now())

  session  BubuiTableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, customerId])
  @@index([sessionId])
  @@index([contributedAt, followupPushedAt])
}

/// Catálogo de productos de un comercio (nicho comercio_producto). Se muestra
/// en su página pública de Bubui; el comercio lo gestiona desde su panel.
model BubuiProduct {
  @@map("BipiProduct")
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?  @db.Text
  priceEur    Float?
  imageUrl    String?
  stock       Int? // null = sin control de stock
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, active])
}

/// Servicio que ofrece un comercio del nicho "servicios" (peluquería, clínica,
/// taller…). El cliente pide cita para uno de ellos.
model BubuiService {
  @@map("BipiService")
  id          String   @id @default(cuid())
  businessId  String
  name        String
  durationMin Int      @default(30)
  // Unidad de cobro/medida en texto libre para servicios que no se miden en
  // minutos (p. ej. "por habitación", "/mes", "por sesión"). Si está vacía, se
  // muestra la duración en minutos.
  unit        String?
  priceEur    Float?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  business BubuiBusiness  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings BubuiBooking[]

  @@index([businessId, active])
}

/// Cita solicitada por un cliente. v1 por solicitud: el cliente elige fecha/hora
/// y el comercio confirma o rechaza desde su panel.
model BubuiBooking {
  @@map("BipiBooking")
  id            String    @id @default(cuid())
  businessId    String
  serviceId     String?
  customerId    String?
  customerName  String
  customerPhone String
  startsAt      DateTime
  notes         String?   @db.Text
  status        String    @default("pending") // pending | confirmed | cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  BubuiService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([businessId, status, startsAt])
}

/// Slot patrocinado: anuncio "hero" del feed del cliente durante una
/// ventana de tiempo (típicamente 24h). El negocio lo activa desde su panel
/// si tiene plan != "free" (cuota mensual por plan). Cliente lo ve marcado
/// como "Patrocinado" al abrir la app, filtrado por su ciudad.
model BubuiSponsoredSlot {
  @@map("BipiSponsoredSlot")
  id         String   @id @default(cuid())
  businessId String
  title      String
  body       String   @db.Text
  city       String
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime @default(now())

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([city, startsAt, endsAt])
  @@index([businessId, startsAt])
}

/// Campaña de banner del Home ganada por un negocio (recompensa de referidos
/// B2B: 1 semana por cada 5 negocios activos que trae). Se sirven por turnos:
/// el banner del Home muestra la campaña activa (status=active) más antigua.
model BubuiBannerCampaign {
  @@map("BipiBannerCampaign")
  id         String   @id @default(cuid())
  businessId String
  // Imagen del banner (la sube el negocio); puede quedar pendiente hasta que
  // la suba — entonces se usa su logo/nombre como fallback.
  imageUrl   String?
  link       String?
  // queued | active | done
  status     String   @default("queued")
  // Semanas concedidas (cada recompensa = 1 semana). Al activarse fija las
  // fechas; mientras está en cola, startsAt/endsAt son null.
  weeks      Int      @default(1)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime @default(now())

  business BubuiBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@index([businessId])
}

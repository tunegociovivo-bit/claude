# ============================================================
# CONFIGURACIÓN - Copia este archivo como .env y rellena los valores
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
# Obtén estos valores en https://developers.facebook.com/apps/
WHATSAPP_TOKEN=EAAG...tu_token_permanente
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=solicitud_resena
WHATSAPP_TEMPLATE_LANG=es

# --- Empresa ---
EMPRESA_NOMBRE="Automatic Choice"
EMPRESA_WEB="https://automaticchoice.es/"

# URL pública donde está alojada la carpeta /public de este proyecto
# (Ejemplo: https://resenas.automaticchoice.es)
BASE_URL=https://automaticchoice.es/resenas

# URL de la ficha de Google My Business para dejar reseña
# Para obtenerla: en Google Maps > tu ficha > Compartir > Pestaña "Insertar mapa"
# O usa el formato: https://search.google.com/local/writereview?placeid=TU_PLACE_ID
GMB_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJxxxxxxxxxxxxxxxx

# --- Email (para recibir quejas de 1-3 estrellas) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@automaticchoice.es
SMTP_PASS=tu_clave_de_aplicacion
SMTP_SECURE=tls
MAIL_FROM=notificaciones@automaticchoice.es
MAIL_FROM_NAME="Sistema de Reseñas"
MAIL_TO=atencionalcliente@automaticchoice.es

# --- Seguridad ---
# Clave aleatoria para firmar los enlaces enviados por WhatsApp y evitar manipulación
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_larga_min_32_chars

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_ventas"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Clave dedicada para cifrar secretos guardados en BD (API keys de WAHA, etc.)
# Independiente de NEXTAUTH_SECRET para poder rotar sesiones sin invalidar secretos.
ENCRYPTION_KEY="cambia-esto-por-otro-secreto-largo"

# URL pública de la app (para construir las URLs de webhooks detrás de proxy)
PUBLIC_APP_URL="https://crm.tudominio.com"

# IA — Anthropic (agente SONIA de WhatsApp)
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo para el agente de WhatsApp (opcional)
SONIA_MODEL="claude-opus-5"

# Aprovisionamiento de teléfonos desde la cuenta maestra de Vapi
VAPI_PHONE_SELF_SERVICE_ENABLED="false"
VAPI_API_KEY=""

# Operadores de Negocio Vivo (rol global, distinto del ADMIN de workspace).
# Emails separados por comas con acceso al panel interno de teléfonos.
# Administradores generales separados por comas.
NV_OPERATOR_EMAILS="tunegociovivo@gmail.com,info@negociovivo.com"
ADMIN_CALL_COST_PER_MINUTE="0.15"
ADMIN_WHATSAPP_COST_PER_MESSAGE="0.005"
ADMIN_USD_TO_EUR_RATE="0.86"

# Aviso operativo cuando un cliente guarda/cambia su teléfono (Resend).
# Sin RESEND_API_KEY no se envía nada: el aviso queda "pendiente" y visible
# en el panel de operador; el guardado del cliente nunca se pierde.
RESEND_API_KEY=""
PHONE_NOTIFY_TO="info@negociovivo.com"
PHONE_NOTIFY_FROM="CRM Ventas <onboarding@resend.dev>"
# Protección adicional: listas separadas por comas. El número actual de SONIA
# también está bloqueado en código para evitar modificaciones accidentales.
VAPI_PROTECTED_PHONE_NUMBER_IDS=""
VAPI_PROTECTED_E164="+34613068550"

# WhatsApp (WAHA) — autoservicio de sesión
# Anti-SSRF: orígenes de servidores WAHA permitidos, separados por comas.
WAHA_ALLOWED_ORIGINS="http://116.203.16.76:3000"
# Sesiones que el CRM nunca debe tocar (además de "default" y cualquier
# nombre que contenga "sonia", bloqueados en código). Separadas por comas.
WAHA_PROTECTED_SESSIONS=""
# Números de WhatsApp protegidos: si una sesión está vinculada a uno de estos
# números, el CRM se niega a desvincularla. Separados por comas.
WAHA_PROTECTED_E164="34613068550"

# Seed inicial
SEED_ADMIN_EMAIL="admin@crm.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_WORKSPACE_NAME="Mi Negocio"

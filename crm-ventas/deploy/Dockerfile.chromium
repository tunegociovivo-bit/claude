# Radar de subastas, opción B: ejecutar Chromium DENTRO del contenedor del CRM
# (sin Browserless ni cuota externa). Se activa desde crm-ventas/railway.json
# (builder DOCKERFILE → esta ruta). El contexto de build es la carpeta
# crm-ventas/ (Root Directory del servicio del CRM en Railway).
#
# Si este build fallara, Railway mantiene vivo el deploy anterior del CRM, así
# que producción no se cae mientras se corrige.

FROM node:20-bookworm-slim

# Chromium del sistema + fuentes y librerías que necesita para arrancar headless.
# Se instala el navegador del SO (no el de Playwright) para no descargar 150 MB
# en cada build y tener las dependencias nativas resueltas por apt.
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      fonts-liberation fonts-noto-color-emoji fonts-noto-cjk \
      ca-certificates \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libasound2 libpango-1.0-0 libcairo2 libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# OJO: NODE_ENV no se fija a "production" aquí: `npm ci` omitiría las
# devDependencies (prisma, typescript, tailwind, postcss, tsx…) que el build
# necesita. Se pone a production al final, solo para el runtime.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    RADAR_CHROMIUM_PATH=/usr/bin/chromium

WORKDIR /app

# Instala dependencias con la lockfile (capa cacheable). --include=dev fuerza
# las devDependencies aunque el entorno traiga NODE_ENV=production.
COPY package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund

# Resto del código y build de Next (incluye `prisma generate`).
COPY . .
RUN npm run build

# A partir de aquí, runtime en modo producción.
ENV NODE_ENV=production
EXPOSE 3000

# Igual que el `start` de package.json: aplica el esquema y arranca Next
# (next start escucha en $PORT, que Railway inyecta).
CMD ["npm", "run", "start"]

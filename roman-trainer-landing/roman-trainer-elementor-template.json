ión</p>\n            <ul class=\"space-y-2 text-white/70\">\n              <li><a href=\"#sobre\" class=\"hover:text-volt transition-colors\">Sobre Roman</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-volt transition-colors\">Servicios</a></li>\n              <li><a href=\"#planes\" class=\"hover:text-volt transition-colors\">Planes</a></li>\n              <li><a href=\"#contacto\" class=\"hover:text-volt transition-colors\">Contacto</a></li>\n            </ul>\n          </div>\n          <div>\n            <p class=\"mb-3 text-sm font-semibold uppercase tracking-widest text-white/40\">Sígueme</p>\n            <div class=\"flex gap-3\">\n              <a href=\"#\" aria-label=\"Instagram\" class=\"grid h-10 w-10 place-items-center rounded-full border border-line text-white/70 transition-colors hover:border-volt hover:text-volt cursor-pointer\">\n                <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><circle cx=\"17.5\" cy=\"6.5\" r=\"1\" fill=\"currentColor\" stroke=\"none\"/></svg>\n              </a>\n              <a href=\"#\" aria-label=\"TikTok\" class=\"grid h-10 w-10 place-items-center rounded-full border border-line text-white/70 transition-colors hover:border-volt hover:text-volt cursor-pointer\">\n                <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-2.59-2.59c.27 0 .53.04.78.12V9.79a5.96 5.96 0 0 0-.78-.05A5.69 5.69 0 1 0 15.54 15.4V9.01a7.34 7.34 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z\"/></svg>\n              </a>\n              <a href=\"#\" aria-label=\"YouTube\" class=\"grid h-10 w-10 place-items-center rounded-full border border-line text-white/70 transition-colors hover:border-volt hover:text-volt cursor-pointer\">\n                <svg class=\"h-5 w-5\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z\"/></svg>\n              </a>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"mt-12 flex flex-col items-center justify-between gap-3 border-t border-line pt-6 text-sm text-white/40 sm:flex-row\">\n        <p>© <span id=\"year\"></span> Roman Trainer. Todos los derechos reservados.</p>\n        <p>Diseño profesional · Listo para tu marca</p>\n      </div>\n    </div>\n  </footer>\n\n  <!-- ============================================================\n       JS — menú móvil, nav scroll, reveal, contadores\n       ============================================================ -->\n  <script>\n    // Año footer\n    document.getElementById('year').textContent = new Date().getFullYear();\n\n    // Menú móvil\n    const menuBtn = document.getElementById('menuBtn');\n    const mobileMenu = document.getElementById('mobileMenu');\n    menuBtn.addEventListener('click', () => {\n      const open = mobileMenu.classList.toggle('hidden') === false;\n      menuBtn.setAttribute('aria-expanded', String(open));\n    });\n    mobileMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {\n      mobileMenu.classList.add('hidden');\n      menuBtn.setAttribute('aria-expanded', 'false');\n    }));\n\n    // Nav: sombra/compresión al hacer scroll\n    const nav = document.getElementById('nav');\n    const onScroll = () => nav.classList.toggle('top-0', window.scrollY > 40);\n    window.addEventListener('scroll', onScroll, { passive: true });\n\n    // Scroll reveal\n    const io = new IntersectionObserver((entries) => {\n      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });\n    }, { threshold: 0.12 });\n    document.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n    // Contadores animados\n    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const formatNum = (n) => n.toLocaleString('es-ES');\n    const animateCount = (el) => {\n      const target = parseInt(el.dataset.count, 10);\n      const suffix = el.dataset.suffix || '';\n      if (prefersReduced) { el.textContent = formatNum(target) + suffix; return; }\n      const dur = 1600; const start = performance.now();\n      const step = (now) => {\n        const p = Math.min((now - start) / dur, 1);\n        const eased = 1 - Math.pow(1 - p, 3);\n        el.textContent = formatNum(Math.floor(eased * target)) + suffix;\n        if (p < 1) requestAnimationFrame(step);\n      };\n      requestAnimationFrame(step);\n    };\n    const countIO = new IntersectionObserver((entries) => {\n      entries.forEach(e => { if (e.isIntersecting) { animateCount(e.target); countIO.unobserve(e.target); } });\n    }, { threshold: 0.5 });\n    document.querySelectorAll('[data-count]').forEach(el => countIO.observe(el));\n  </script>\n</div>"

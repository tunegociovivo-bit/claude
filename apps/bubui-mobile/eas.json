{
    "cli": {
          "version": ">= 5.0.0",
          "appVersionSource": "remote"
    },
    "build": {
          "preview": {
                  "distribution": "internal",
                  "autoIncrement": true,
                  "prebuildCommand": "npx expo prebuild --clean",
                  "android": {
                            "buildType": "apk"
                  },
                  "ios": {
                            "simulator": false
                  }
          },
          "ios-simulator": {
                  "distribution": "internal",
                  "prebuildCommand": "npx expo prebuild --clean",
                  "ios": {
                            "simulator": true
                  }
          },
          "production": {
                  "autoIncrement": true,
                  "prebuildCommand": "npx expo prebuild --clean",
                  "android": {
                            "buildType": "app-bundle"
                  },
                  "ios": {
                            "buildConfiguration": "Release",
                            "credentialsSource": "remote",
                            "image": "latest"
                  }
          }
    },
    "submit": {
          "production": {
                  "ios": {
                            "ascAppId": "6776224976",
                            "appleTeamId": "9J97GC5NCG"
                  }
          }
    }
}

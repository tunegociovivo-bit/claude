{
  "expo": {
    "name": "Bubui",
    "slug": "bipi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "bubui",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.negociovivo.bubui",
      "infoPlist": {
        "NSCameraUsageDescription": "Bubui necesita la cámara para escanear el QR de los negocios y aplicarte el descuento.",
        "NSLocationWhenInUseUsageDescription": "Bubui usa tu ubicación para mostrarte los descuentos cerca de ti.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Bubui usa tu ubicación para avisarte de descuentos cuando pases cerca."
      }
    },
    "android": {
      "package": "com.negociovivo.bubui",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bubui.app",
              "pathPrefix": "/scan"
            },
            {
              "scheme": "https",
              "host": "hub.negociovivo.app",
              "pathPrefix": "/bubui/scan"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bubui necesita la cámara para escanear el QR de los negocios."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bubui usa tu ubicación para mostrar descuentos cerca y avisarte cuando pases junto a uno."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-build-properties"
    ],
    "extra": {
      "apiBaseUrl": "https://bubui.app",
      "eas": {
        "projectId": "d8f1d22c-36b4-416e-9c91-1a681b4c37d5"
      }
    },
    "owner": "bipiapp"
  }
}
